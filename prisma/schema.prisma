// Music Madras — Canonical MMKE Database Schema
//
// This is the ONE canonical persistent source of truth for the MMKE domain
// model, per docs/architecture/ADR-0001-production-platform.md (sections
// 4, 5, 6, 15, 16, 17).
//
// Phase 1 scope (see docs/phase-1-foundation.md for the full explanation):
//   - The core canonical catalogue entities (ADR §4).
//   - The Recording / RecordingRevision draft-and-publish model (ADR §5),
//     with exactly one normalized representation of a recording's content
//     at any point in time — no JSON shadow state, no draftPayload blob.
//   - The YouTubeVideo / YouTubePlaylist / YouTubePlaylistItem resource
//     tables, including their observabilityState column (ADR §15), because
//     MediaResource and Collection reference them. Their *behaviour*
//     (sync engine, field ownership, conflict resolution — ADR §11-16) is
//     explicitly NOT implemented in Phase 1.
//   - A minimal StudioUser table exists ONLY as the createdBy/updatedBy
//     foreign-key target the ADR's entity pattern requires. It has no
//     password/session/invitation fields — the full account lifecycle
//     (ADR §7) is a later phase. This is a deliberate scope note, not a
//     silent architecture change; see docs/phase-1-foundation.md.
//
// Explicitly OUT of scope for this schema (later phases, per the ADR):
//   - FieldOwnership / SyncConflict (ADR §16)
//   - ObservabilityTransition / SyncPolicy (ADR §15)
//   - SyncCheckpoint / SyncJobRun (ADR §12, §13)
//   - Session / Account / Invitation / PasswordResetToken (ADR §7)
// These are added alongside the code that actually uses them, in the
// phases where the YouTube sync engine and authentication are built.

generator client {
  provider = "prisma-client-js"
}

// Connection URLs are configured in prisma.config.ts (Prisma ORM 7+),
// not here. The CLI (migrate/db push) uses DIRECT_URL; the application
// runtime uses DATABASE_URL (pooled) via a driver adapter in
// modules/db/client.ts. See ADR §6.3.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum StudioRole {
  FOUNDER
  SUPER_ADMINISTRATOR
  ADMINISTRATOR
  EDITOR
  REVIEWER
  CONTRIBUTOR
}

enum StudioUserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum RecordingAggregateStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum RevisionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum VenueType {
  CHURCH
  CATHEDRAL
  CONCERT_HALL
  STUDIO
  OUTDOOR
}

enum MediaProvider {
  YOUTUBE
  UPLOAD
}

enum MediaRole {
  PRIMARY_VIDEO
  THUMBNAIL
  POSTER
  PROGRAMME_PDF
  SHEET_MUSIC
  AUDIO_MASTER
}

enum ObservabilityState {
  OBSERVED
  NOT_OBSERVED
  PRIVATE
  UNLISTED
  UNAVAILABLE
  DELETED
  SYNC_ERROR
}

enum SheetMusicRequestStatus {
  NEW
  IN_REVIEW
  FULFILLED
  DECLINED
}

// Phase 2 (brief §8): a simple publish toggle for Collections, distinct
// from the Recording Draft & Revision model — Collections are curated
// groupings, not richly-authored content, so a full revision history
// would be over-engineering (and would risk becoming "another
// snapshot/versioning mechanism," which the Phase 2 brief explicitly
// rules out). Archival still uses the existing archivedAt column, for
// consistency with every other entity.
enum CollectionStatus {
  DRAFT
  PUBLISHED
}

// ---------------------------------------------------------------------------
// Studio identity (minimal — see file header note)
// ---------------------------------------------------------------------------

model StudioUser {
  id           String           @id @default(uuid())
  email        String           @unique
  name         String
  role         StudioRole
  status       StudioUserStatus @default(INVITED)
  // Phase 4: nullable because an account may exist before a password is
  // set (freshly invited, or a future Google-only account) — the ADR's
  // Credentials provider checks this directly; Auth.js's own "User" model
  // is deliberately NOT used for identity (see docs/phase-4-studio.md) so
  // there is exactly one user-identity table, not two.
  passwordHash String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  sessions            StudioSession[]
  accounts            StudioAccount[]
  invitationsSent     Invitation[]         @relation("InvitationInvitedBy")
  passwordResetTokens PasswordResetToken[]

  composersCreated          Composer[]           @relation("ComposerCreatedBy")
  composersUpdated          Composer[]           @relation("ComposerUpdatedBy")
  worksCreated              MusicalWork[]        @relation("MusicalWorkCreatedBy")
  worksUpdated              MusicalWork[]        @relation("MusicalWorkUpdatedBy")
  programmesCreated         Programme[]          @relation("ProgrammeCreatedBy")
  programmesUpdated         Programme[]          @relation("ProgrammeUpdatedBy")
  performancesCreated       Performance[]        @relation("PerformanceCreatedBy")
  performancesUpdated       Performance[]        @relation("PerformanceUpdatedBy")
  recordingsCreated         Recording[]          @relation("RecordingCreatedBy")
  recordingsUpdated         Recording[]          @relation("RecordingUpdatedBy")
  revisionsCreated          RecordingRevision[]  @relation("RevisionCreatedBy")
  revisionsUpdated          RecordingRevision[]  @relation("RevisionUpdatedBy")
  artistsCreated            Artist[]             @relation("ArtistCreatedBy")
  artistsUpdated            Artist[]             @relation("ArtistUpdatedBy")
  choirsCreated             Choir[]              @relation("ChoirCreatedBy")
  choirsUpdated             Choir[]              @relation("ChoirUpdatedBy")
  conductorsCreated         Conductor[]          @relation("ConductorCreatedBy")
  conductorsUpdated         Conductor[]          @relation("ConductorUpdatedBy")
  organisationsCreated      Organisation[]       @relation("OrganisationCreatedBy")
  organisationsUpdated      Organisation[]       @relation("OrganisationUpdatedBy")
  venuesCreated             Venue[]              @relation("VenueCreatedBy")
  venuesUpdated             Venue[]              @relation("VenueUpdatedBy")
  instrumentsCreated        Instrument[]         @relation("InstrumentCreatedBy")
  instrumentsUpdated        Instrument[]         @relation("InstrumentUpdatedBy")
  collectionsCreated        Collection[]         @relation("CollectionCreatedBy")
  collectionsUpdated        Collection[]         @relation("CollectionUpdatedBy")
  learningGuidesCreated     LearningGuide[]      @relation("LearningGuideCreatedBy")
  learningGuidesUpdated     LearningGuide[]      @relation("LearningGuideUpdatedBy")
  educationalContentCreated EducationalContent[] @relation("EducationalContentCreatedBy")
  educationalContentUpdated EducationalContent[] @relation("EducationalContentUpdatedBy")
  editorialContentCreated   EditorialContent[]   @relation("EditorialContentCreatedBy")
  editorialContentUpdated   EditorialContent[]   @relation("EditorialContentUpdatedBy")
  auditLogEntries           AuditLogEntry[]      @relation("AuditLogActor")

  @@map("studio_users")
}

// ---------------------------------------------------------------------------
// Authentication (Phase 4, ADR §7) — session/OAuth-linkage bookkeeping only.
//
// These are NOT Auth.js's own generic "Session"/"Account" Prisma models.
// The off-the-shelf @auth/prisma-adapter hardcodes calls against models
// literally named User/Session/Account/VerificationToken (its documented
// @map() naming-convention support only renames columns/tables, not the
// Prisma Client model itself) — adopting it as-is would have required
// either renaming StudioUser to User throughout three already-completed
// phases, or maintaining a second, duplicate user-identity table (email/
// name held in both "User" and "StudioUser"), which this project has
// consistently avoided everywhere else (see e.g. the Venue/Organisation
// and MediaResource FK decisions in docs/phase-2-mmke-domain.md).
//
// Instead, modules/auth/ implements a custom Auth.js Adapter (an
// officially-supported extension point, not a workaround) against these
// two tables plus the existing StudioUser — see docs/phase-4-studio.md.
// No VerificationToken table exists because this project uses only the
// Credentials and (optional) Google OAuth providers, never Auth.js's
// email/magic-link provider, which is the only thing that model is for.
// ---------------------------------------------------------------------------

model StudioSession {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  studioUserId String
  expires      DateTime

  studioUser StudioUser @relation(fields: [studioUserId], references: [id], onDelete: Cascade)

  @@index([studioUserId])
  @@map("studio_sessions")
}

model StudioAccount {
  id                String  @id @default(uuid())
  studioUserId      String
  type              String // Auth.js AdapterAccount.type, e.g. "oauth"
  provider          String // e.g. "google"
  providerAccountId String
  refreshToken      String? @db.Text
  accessToken       String? @db.Text
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String? @db.Text
  sessionState      String?

  studioUser StudioUser @relation(fields: [studioUserId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([studioUserId])
  @@map("studio_accounts")
}

// ---------------------------------------------------------------------------
// Invitation & password reset (Phase 4, ADR §7) — Music Madras's own
// tables, unrelated to Auth.js. Studio is invite-only: there is no
// /studio/register route anywhere in app/(studio), and account creation
// only ever happens through modules/auth's invitation-acceptance flow.
// ---------------------------------------------------------------------------

model Invitation {
  id          String     @id @default(uuid())
  email       String
  role        StudioRole
  invitedById String
  // Only the hash is stored — the raw token exists only in the invite
  // link/email at issuance time, exactly like PasswordResetToken below.
  tokenHash   String     @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime   @default(now())

  invitedBy StudioUser @relation("InvitationInvitedBy", fields: [invitedById], references: [id])

  @@index([email])
  @@map("invitations")
}

model PasswordResetToken {
  id           String    @id @default(uuid())
  studioUserId String
  tokenHash    String    @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  studioUser StudioUser @relation(fields: [studioUserId], references: [id], onDelete: Cascade)

  @@index([studioUserId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Canonical catalogue — Composer / MusicalWork / Programme / Performance
// ---------------------------------------------------------------------------

model Composer {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  bornDate    String?
  diedDate    String?
  era         String?
  biography   String?   @db.Text
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String
  updatedById String

  createdBy StudioUser @relation("ComposerCreatedBy", fields: [createdById], references: [id])
  updatedBy StudioUser @relation("ComposerUpdatedBy", fields: [updatedById], references: [id])

  works          MusicalWork[]
  mediaResources MediaResource[]

  @@index([archivedAt])
  @@map("composers")
}

model MusicalWork {
  id              String    @id @default(uuid())
  slug            String    @unique
  title           String
  // Phase 2 additions (brief §5 — support the catalogue depth GAIS's own
  // CANONICAL_MODELS.md aspired to for Western Classical + related
  // choral/historical material, without assuming one musical tradition):
  alternateTitles String[]  @default([])
  language        String?
  notes           String?   @db.Text
  catalogueNumber String?
  keySignature    String?
  composerId      String
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String
  updatedById     String

  composer  Composer   @relation(fields: [composerId], references: [id], onDelete: Restrict)
  createdBy StudioUser @relation("MusicalWorkCreatedBy", fields: [createdById], references: [id])
  updatedBy StudioUser @relation("MusicalWorkUpdatedBy", fields: [updatedById], references: [id])

  programmeItems         ProgrammeItem[]
  recordingRevisionLinks RecordingRevisionWork[]
  sheetMusicRequests     SheetMusicRequest[]
  learningGuideLinks     LearningGuideWork[]
  collectionLinks        CollectionWork[]

  @@index([composerId])
  @@index([archivedAt])
  @@map("musical_works")
}

model Programme {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  notes       String?   @db.Text
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String
  updatedById String

  createdBy StudioUser @relation("ProgrammeCreatedBy", fields: [createdById], references: [id])
  updatedBy StudioUser @relation("ProgrammeUpdatedBy", fields: [updatedById], references: [id])

  items        ProgrammeItem[]
  performances Performance[]

  @@index([archivedAt])
  @@map("programmes")
}

model ProgrammeItem {
  id            String  @id @default(uuid())
  programmeId   String
  musicalWorkId String
  order         Int
  movement      String?
  isEncore      Boolean @default(false)

  programme   Programme   @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  musicalWork MusicalWork @relation(fields: [musicalWorkId], references: [id], onDelete: Restrict)

  @@unique([programmeId, order])
  @@index([musicalWorkId])
  @@map("programme_items")
}

model Performance {
  id              String    @id @default(uuid())
  programmeId     String
  venueId         String
  performanceDate DateTime?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String
  updatedById     String

  programme Programme  @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  venue     Venue      @relation(fields: [venueId], references: [id], onDelete: Restrict)
  createdBy StudioUser @relation("PerformanceCreatedBy", fields: [createdById], references: [id])
  updatedBy StudioUser @relation("PerformanceUpdatedBy", fields: [updatedById], references: [id])

  revisions   RecordingRevision[]
  instruments Instrument[]
  performers  PerformancePerformer[]
  choirs      PerformanceChoir[]
  conductors  PerformanceConductor[]

  @@index([programmeId])
  @@index([venueId])
  @@index([archivedAt])
  @@map("performances")
}

// ---------------------------------------------------------------------------
// Participants and their join tables to Performance (ADR §4 — explicit
// relationships, not free-text strings)
// ---------------------------------------------------------------------------

model Artist {
  id          String    @id @default(uuid())
  name        String
  instrument  String?
  biography   String?   @db.Text
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String
  updatedById String

  createdBy StudioUser @relation("ArtistCreatedBy", fields: [createdById], references: [id])
  updatedBy StudioUser @relation("ArtistUpdatedBy", fields: [updatedById], references: [id])

  performances PerformancePerformer[]

  @@map("artists")
}

model Choir {
  id           String    @id @default(uuid())
  name         String
  directorName String?
  description  String?   @db.Text
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String
  updatedById  String

  createdBy StudioUser @relation("ChoirCreatedBy", fields: [createdById], references: [id])
  updatedBy StudioUser @relation("ChoirUpdatedBy", fields: [updatedById], references: [id])

  performances PerformanceChoir[]

  @@map("choirs")
}

model Conductor {
  id          String    @id @default(uuid())
  name        String
  biography   String?   @db.Text
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String
  updatedById String

  createdBy StudioUser @relation("ConductorCreatedBy", fields: [createdById], references: [id])
  updatedBy StudioUser @relation("ConductorUpdatedBy", fields: [updatedById], references: [id])

  performances PerformanceConductor[]

  @@map("conductors")
}

model Organisation {
  id          String    @id @default(uuid())
  name        String
  description String?   @db.Text
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String
  updatedById String

  createdBy StudioUser @relation("OrganisationCreatedBy", fields: [createdById], references: [id])
  updatedBy StudioUser @relation("OrganisationUpdatedBy", fields: [updatedById], references: [id])

  venues Venue[]

  @@map("organisations")
}

model PerformancePerformer {
  performanceId String
  artistId      String
  // Phase 2: e.g. "Soloist", "Organist", "Accompanist" — a free-text role
  // label kept deliberately simple (brief §6: "extensible for future
  // participant roles without creating an unnecessarily complex role
  // engine"). A controlled enum would need a migration for every new role
  // Music Madras wants to record; this does not.
  role          String?

  performance Performance @relation(fields: [performanceId], references: [id], onDelete: Cascade)
  artist      Artist      @relation(fields: [artistId], references: [id], onDelete: Restrict)

  @@id([performanceId, artistId])
  @@map("performance_performers")
}

model PerformanceChoir {
  performanceId String
  choirId       String

  performance Performance @relation(fields: [performanceId], references: [id], onDelete: Cascade)
  choir       Choir       @relation(fields: [choirId], references: [id], onDelete: Restrict)

  @@id([performanceId, choirId])
  @@map("performance_choirs")
}

model PerformanceConductor {
  performanceId String
  conductorId   String

  performance Performance @relation(fields: [performanceId], references: [id], onDelete: Cascade)
  conductor   Conductor   @relation(fields: [conductorId], references: [id], onDelete: Restrict)

  @@id([performanceId, conductorId])
  @@map("performance_conductors")
}

// ---------------------------------------------------------------------------
// Venue / Church (one table, per ADR §4) and Instrument
// ---------------------------------------------------------------------------

model Venue {
  id              String    @id @default(uuid())
  slug            String    @unique
  name            String
  type            VenueType
  address         String?
  city            String?
  country         String?
  capacity        Int?
  acousticProfile String?
  // Phase 2 (brief §7): a Church (or any Venue) may also be a meaningful
  // organisation/entity in the cultural catalogue — e.g. the congregation
  // or trust that operates the building, distinct from the physical place
  // itself, and potentially operating more than one venue over time. This
  // is deliberately the smallest justified addition: an OPTIONAL link,
  // not a merge of Venue and Organisation into one table (which would
  // wrongly conflate "a physical place" with "an institution") and not a
  // second Church-specific table (which would risk duplicate venue/church
  // records for the same building). See docs/phase-2-mmke-domain.md §7
  // for the full reasoning.
  organisationId  String?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String
  updatedById     String

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  createdBy    StudioUser    @relation("VenueCreatedBy", fields: [createdById], references: [id])
  updatedBy    StudioUser    @relation("VenueUpdatedBy", fields: [updatedById], references: [id])

  performances   Performance[]
  instruments    Instrument[]
  mediaResources MediaResource[]

  @@index([archivedAt])
  @@index([organisationId])
  @@map("venues")
}

model Instrument {
  id            String    @id @default(uuid())
  name          String
  manufacturer  String?
  buildYear     String?
  venueId       String
  performanceId String?
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String
  updatedById   String

  venue       Venue        @relation(fields: [venueId], references: [id], onDelete: Restrict)
  performance Performance? @relation(fields: [performanceId], references: [id], onDelete: SetNull)
  createdBy   StudioUser   @relation("InstrumentCreatedBy", fields: [createdById], references: [id])
  updatedBy   StudioUser   @relation("InstrumentUpdatedBy", fields: [updatedById], references: [id])

  @@index([venueId])
  @@map("instruments")
}

// ---------------------------------------------------------------------------
// Recording identity + Draft/Revision model (ADR §5 — the one canonical
// representation; no JSON shadow state, no draftPayload)
// ---------------------------------------------------------------------------

model Recording {
  id                         String                   @id @default(uuid())
  slug                       String                   @unique
  status                     RecordingAggregateStatus @default(DRAFT)
  currentDraftRevisionId     String?                  @unique
  currentPublishedRevisionId String?                  @unique
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  createdById                String
  updatedById                String

  createdBy StudioUser @relation("RecordingCreatedBy", fields: [createdById], references: [id])
  updatedBy StudioUser @relation("RecordingUpdatedBy", fields: [updatedById], references: [id])

  // Pointers into the revision history below. Nullable and SetNull on
  // delete because these are pointers, not ownership — the true ownership
  // FK is RecordingRevision.recordingId (Cascade), the reverse direction.
  currentDraftRevision     RecordingRevision? @relation("RecordingCurrentDraft", fields: [currentDraftRevisionId], references: [id], onDelete: SetNull)
  currentPublishedRevision RecordingRevision? @relation("RecordingCurrentPublished", fields: [currentPublishedRevisionId], references: [id], onDelete: SetNull)

  revisions          RecordingRevision[]      @relation("RecordingRevisions")
  sheetMusicRequests SheetMusicRequest[]
  collectionLinks    CollectionRecording[]
  learningGuideLinks LearningGuideRecording[]

  @@map("recordings")
}

model RecordingRevision {
  id             String         @id @default(uuid())
  recordingId    String
  revisionNumber Int
  revisionStatus RevisionStatus @default(DRAFT)

  // Core content — see ADR §5.1. This IS the canonical representation;
  // there is no parallel JSON document anywhere holding the same data.
  title       String?
  description String? @db.Text

  performanceId String?
  performance   Performance? @relation(fields: [performanceId], references: [id], onDelete: SetNull)

  // SEO fields (ADR §19) — distinct, real columns; not a duplicate
  // representation of catalogue data, just revision-specific metadata.
  seoMetaTitle       String?
  seoMetaDescription String? @db.Text
  seoCanonicalPath   String?

  // Educational content fields (ADR §4 Studio wizard "Educational" step).
  educationalDifficultyLevel String?
  educationalListeningGuide  String? @db.Text
  educationalAnalysis        String? @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  updatedById String

  recording Recording  @relation("RecordingRevisions", fields: [recordingId], references: [id], onDelete: Cascade)
  createdBy StudioUser @relation("RevisionCreatedBy", fields: [createdById], references: [id])
  updatedBy StudioUser @relation("RevisionUpdatedBy", fields: [updatedById], references: [id])

  // Reverse side of Recording.currentDraftRevisionId / currentPublishedRevisionId.
  currentDraftOf     Recording? @relation("RecordingCurrentDraft")
  currentPublishedOf Recording? @relation("RecordingCurrentPublished")

  works          RecordingRevisionWork[]
  mediaResources MediaResource[]

  @@unique([recordingId, revisionNumber])
  @@index([performanceId])
  @@map("recording_revisions")
}

model RecordingRevisionWork {
  revisionId              String
  musicalWorkId           String
  order                   Int
  catalogueNumberOverride String?

  revision    RecordingRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  musicalWork MusicalWork       @relation(fields: [musicalWorkId], references: [id], onDelete: Restrict)

  @@id([revisionId, musicalWorkId])
  @@map("recording_revision_works")
}

// ---------------------------------------------------------------------------
// Collections (replaces the prototype's ad-hoc Playlist type — ADR §4/§14)
// ---------------------------------------------------------------------------

model Collection {
  id                String           @id @default(uuid())
  slug              String           @unique
  title             String
  description       String?          @db.Text
  status            CollectionStatus @default(DRAFT)
  backingPlaylistId String?
  archivedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  createdById       String
  updatedById       String

  backingPlaylist YouTubePlaylist? @relation(fields: [backingPlaylistId], references: [id], onDelete: SetNull)
  createdBy       StudioUser       @relation("CollectionCreatedBy", fields: [createdById], references: [id])
  updatedBy       StudioUser       @relation("CollectionUpdatedBy", fields: [updatedById], references: [id])

  recordingLinks CollectionRecording[]
  workLinks      CollectionWork[]
  mediaResources MediaResource[]

  @@index([archivedAt])
  @@map("collections")
}

model CollectionRecording {
  collectionId String
  recordingId  String
  order        Int

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  recording  Recording  @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@id([collectionId, recordingId])
  @@map("collection_recordings")
}

model CollectionWork {
  collectionId  String
  musicalWorkId String
  order         Int

  collection  Collection  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  musicalWork MusicalWork @relation(fields: [musicalWorkId], references: [id], onDelete: Cascade)

  @@id([collectionId, musicalWorkId])
  @@map("collection_works")
}

// ---------------------------------------------------------------------------
// Educational content, Learning guides, Editorial content
// ---------------------------------------------------------------------------

model LearningGuide {
  id                          String    @id @default(uuid())
  slug                        String    @unique
  title                       String
  difficultyLevel             String?
  contentMarkdown             String?   @db.Text
  estimatedReadingTimeMinutes Int?
  archivedAt                  DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  createdById                 String
  updatedById                 String

  createdBy StudioUser @relation("LearningGuideCreatedBy", fields: [createdById], references: [id])
  updatedBy StudioUser @relation("LearningGuideUpdatedBy", fields: [updatedById], references: [id])

  workLinks      LearningGuideWork[]
  recordingLinks LearningGuideRecording[]
  mediaResources MediaResource[]

  @@index([archivedAt])
  @@map("learning_guides")
}

model LearningGuideWork {
  learningGuideId String
  musicalWorkId   String

  learningGuide LearningGuide @relation(fields: [learningGuideId], references: [id], onDelete: Cascade)
  musicalWork   MusicalWork   @relation(fields: [musicalWorkId], references: [id], onDelete: Cascade)

  @@id([learningGuideId, musicalWorkId])
  @@map("learning_guide_works")
}

model LearningGuideRecording {
  learningGuideId String
  recordingId     String

  learningGuide LearningGuide @relation(fields: [learningGuideId], references: [id], onDelete: Cascade)
  recording     Recording     @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@id([learningGuideId, recordingId])
  @@map("learning_guide_recordings")
}

// A smaller, reusable educational content unit (ADR §4 lists this
// separately from LearningGuide but does not detail its shape beyond one
// line). Kept deliberately minimal — no public route/slug is specified
// for it in ADR §3, unlike LearningGuide's `/learning/[slug]`.
model EducationalContent {
  id          String    @id @default(uuid())
  title       String
  body        String?   @db.Text
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String
  updatedById String

  createdBy StudioUser @relation("EducationalContentCreatedBy", fields: [createdById], references: [id])
  updatedBy StudioUser @relation("EducationalContentUpdatedBy", fields: [updatedById], references: [id])

  // Phase 2: generic attachment to any MMKE entity (see EntityEducationalContent).
  linkedEntities EntityEducationalContent[]

  @@map("educational_content")
}

model EditorialContent {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  body        String?   @db.Text
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String
  updatedById String

  createdBy      StudioUser      @relation("EditorialContentCreatedBy", fields: [createdById], references: [id])
  updatedBy      StudioUser      @relation("EditorialContentUpdatedBy", fields: [updatedById], references: [id])
  mediaResources MediaResource[]

  @@index([archivedAt])
  @@map("editorial_content")
}

// ---------------------------------------------------------------------------
// Media (ADR §4, §18) — explicit nullable FK per attachable parent type,
// rather than an unconstrained polymorphic (type, id) pair, so referential
// integrity is real.
// ---------------------------------------------------------------------------

model MediaResource {
  id                 String        @id @default(uuid())
  provider           MediaProvider
  // Fallback for providers without a canonical table yet (e.g. a future
  // Vimeo/Spotify adapter). When provider = YOUTUBE, prefer the real
  // youtubeVideoId relation below instead — Phase 1 only had this loose
  // string, which was exactly the "free text instead of a relationship"
  // gap the Phase 2 relationship review flagged (ADR §3's Recording ->
  // YouTubeVideo chain).
  providerResourceId String?
  role               MediaRole
  url                String?

  recordingRevisionId String?
  composerId          String?
  venueId             String?
  collectionId        String?
  learningGuideId     String?
  editorialContentId  String?
  youtubeVideoId      String?
  rightsInformationId String?

  recordingRevision RecordingRevision? @relation(fields: [recordingRevisionId], references: [id], onDelete: Cascade)
  composer          Composer?          @relation(fields: [composerId], references: [id], onDelete: Cascade)
  venue             Venue?             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  collection        Collection?        @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  learningGuide     LearningGuide?     @relation(fields: [learningGuideId], references: [id], onDelete: Cascade)
  editorialContent  EditorialContent?  @relation(fields: [editorialContentId], references: [id], onDelete: Cascade)
  // Phase 2: real relationship instead of a bare string.
  youtubeVideo      YouTubeVideo?      @relation(fields: [youtubeVideoId], references: [id], onDelete: SetNull)
  // Phase 2: rights-aware by construction (ADR §17/§10).
  rightsInformation RightsInformation? @relation(fields: [rightsInformationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recordingRevisionId])
  @@index([youtubeVideoId])
  @@index([rightsInformationId])
  @@map("media_resources")
}

// ---------------------------------------------------------------------------
// YouTube resource tables — schema only (ADR §4 explicitly requires these
// as foundations). No sync engine, adapter, ownership, or conflict logic
// is implemented in Phase 1; see ADR §11-16 for that design.
// ---------------------------------------------------------------------------

model YouTubeVideo {
  id                 String             @id @default(uuid())
  youtubeVideoId     String             @unique
  title              String?
  description        String?            @db.Text
  thumbnailUrl       String?
  publishedAt        DateTime?
  durationSeconds    Int?
  etag               String?
  contentHash        String?
  observabilityState ObservabilityState @default(OBSERVED)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  playlistItems         YouTubePlaylistItem[]
  mediaResources        MediaResource[]
  analyticsObservations YouTubeAnalyticsObservation[]

  @@map("youtube_videos")
}

model YouTubePlaylist {
  id                 String             @id @default(uuid())
  youtubePlaylistId  String             @unique
  title              String?
  description        String?            @db.Text
  etag               String?
  contentHash        String?
  observabilityState ObservabilityState @default(OBSERVED)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  items       YouTubePlaylistItem[]
  collections Collection[]

  @@map("youtube_playlists")
}

model YouTubePlaylistItem {
  id                 String             @id @default(uuid())
  playlistId         String
  youtubeVideoId     String
  position           Int
  etag               String?
  observabilityState ObservabilityState @default(OBSERVED)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  playlist YouTubePlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  video    YouTubeVideo    @relation(fields: [youtubeVideoId], references: [id], onDelete: Cascade)

  @@unique([playlistId, youtubeVideoId])
  @@index([playlistId, position])
  @@map("youtube_playlist_items")
}

// ---------------------------------------------------------------------------
// YouTube Analytics observations (Phase 3, brief §8-11) — normalized,
// synchronized performance measurements from the YouTube Analytics API.
// This is deliberately a *different* table from YouTubeVideo/Playlist
// above: those answer "what exists" (YouTube Data API); this answers "how
// is it performing" (YouTube Analytics API). YouTube Analytics remains
// authoritative for these numbers — this table stores synchronized
// observations, not a competing source of truth.
//
// One row per (scope, target, metric, period, dimension breakdown) rather
// than one enormous row with a nullable column per possible metric —
// avoids both the "one giant table" anti-pattern and a full data
// warehouse. `dimensions` is a small JSON breakdown (e.g.
// {"trafficSource":"YT_SEARCH"} or {"country":"IN","device":"MOBILE"})
// because YouTube Analytics reports can be sliced by an open-ended
// combination of dimensions (brief §8) — this is NOT the "JSON shadow
// state" the project has been careful to avoid elsewhere, because there is
// no ambiguity about a second source of truth: this JSON only ever holds
// a reporting breakdown, never catalogue identity. `dimensionsHash` is a
// deterministic hash of the canonicalized `dimensions` JSON, used because
// Prisma/Postgres unique constraints are far more reliable on a plain
// scalar column than directly on a JSON column — this is what makes
// re-running a sync idempotent (brief §10).
// ---------------------------------------------------------------------------

enum YouTubeAnalyticsScope {
  CHANNEL
  VIDEO
}

enum YouTubeAnalyticsMetric {
  VIEWS
  WATCH_TIME_MINUTES
  AVERAGE_VIEW_DURATION_SECONDS
  AVERAGE_VIEW_PERCENTAGE
  LIKES
  COMMENTS
  SHARES
  SUBSCRIBERS_GAINED
  SUBSCRIBERS_LOST
}

model YouTubeAnalyticsObservation {
  id             String                 @id @default(uuid())
  scope          YouTubeAnalyticsScope
  // Postgres treats NULL as distinct from every other NULL in a unique
  // constraint, so a nullable youtubeVideoId/channelId pair cannot safely
  // sit inside @@unique below — two CHANNEL-scoped rows (where
  // youtubeVideoId is null) would never collide and idempotency would
  // silently break for exactly that scope. targetKey is a non-null
  // application-computed value (youtubeVideoId when scope = VIDEO,
  // channelId when scope = CHANNEL) used ONLY for uniqueness.
  // youtubeVideoId/channelId below remain the real, nullable columns used
  // for actual relational queries and joins.
  targetKey      String
  youtubeVideoId String? // the real FK, set when scope = VIDEO
  channelId      String? // the external YouTube channel id; set when scope = CHANNEL,
  // and also optionally stamped on VIDEO-scoped rows for convenient
  // channel-wide queries. No dedicated YouTubeChannel table yet — Music
  // Madras has exactly one channel today, so a full entity would be
  // premature; add one if/when a second channel or richer channel
  // metadata is actually needed.
  metric         YouTubeAnalyticsMetric
  periodStart    DateTime
  periodEnd      DateTime
  value          Float
  dimensions     Json? // optional reporting breakdown — see note above
  dimensionsHash String                 @default("") // canonicalized hash of `dimensions`; "" when there is none

  // Loose forward-reference, not a foreign key: SyncJobRun (ADR §12-13)
  // does not exist yet (deferred to the phase that builds the YouTube Data
  // sync engine). This becomes a real FK once that table exists, rather
  // than introducing a second, analytics-specific job-run table now.
  syncJobRunId String?
  source       String   @default("youtube_analytics_api")
  syncedAt     DateTime @default(now())

  video YouTubeVideo? @relation(fields: [youtubeVideoId], references: [id], onDelete: Cascade)

  @@unique([scope, targetKey, metric, periodStart, periodEnd, dimensionsHash])
  @@index([youtubeVideoId, metric, periodStart])
  @@index([channelId, metric, periodStart])
  @@map("youtube_analytics_observations")
}

// ---------------------------------------------------------------------------
// Sheet Music Requests (ADR §17)
// ---------------------------------------------------------------------------

model SheetMusicRequest {
  id                String                  @id @default(uuid())
  requesterName     String
  requesterEmail    String
  musicalWorkId     String?
  recordingId       String?
  instrumentOrVoice String?
  intendedUse       String?
  message           String?                 @db.Text
  status            SheetMusicRequestStatus @default(NEW)
  consentGivenAt    DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  musicalWork MusicalWork? @relation(fields: [musicalWorkId], references: [id], onDelete: SetNull)
  recording   Recording?   @relation(fields: [recordingId], references: [id], onDelete: SetNull)

  @@index([musicalWorkId])
  @@index([status])
  @@map("sheet_music_requests")
}

// ---------------------------------------------------------------------------
// Provenance — Source / Citation / RightsInformation (ADR §4), attached to
// any entity via a generic entityType/entityId join, exactly as the ADR
// itself specifies this one as a genuinely generic/polymorphic case.
// ---------------------------------------------------------------------------

model Source {
  id        String   @id @default(uuid())
  title     String?
  url       String?
  publisher String?
  createdAt DateTime @default(now())

  citations   Citation[]
  entityLinks EntitySource[]

  @@map("sources")
}

model Citation {
  id        String   @id @default(uuid())
  text      String?  @db.Text
  sourceId  String?
  createdAt DateTime @default(now())

  source Source? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@map("citations")
}

model RightsInformation {
  id          String   @id @default(uuid())
  holder      String?
  licenseType String?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())

  // Direct link for the common case (a specific media asset's rights —
  // ADR §17's "attaching a MediaResource... with its own RightsInformation").
  mediaResources MediaResource[]
  // Generic link for entity-level rights (e.g. a MusicalWork's copyright
  // status, independent of any one recording of it) — Phase 2, mirrors
  // EntitySource's pattern.
  entityLinks    EntityRights[]

  @@map("rights_information")
}

model EntitySource {
  id         String @id @default(uuid())
  entityType String
  entityId   String
  sourceId   String

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@map("entity_sources")
}

// Generic entity-level rights attachment (Phase 2) — mirrors EntitySource
// exactly, per ADR §10's rights-aware-publishing foundation. Used for
// rights that belong to an entity itself (e.g. a MusicalWork's copyright
// status) rather than to one specific MediaResource (which has its own
// direct rightsInformationId instead).
model EntityRights {
  id                  String @id @default(uuid())
  entityType          String
  entityId            String
  rightsInformationId String

  rightsInformation RightsInformation @relation(fields: [rightsInformationId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@map("entity_rights")
}

// Generic entity-level educational content attachment (Phase 2) — mirrors
// EntitySource/EntityRights. Lets an EducationalContent block contextualize
// any entity (a Recording, a MusicalWork, a Composer, ...) without a
// dedicated join table per entity type (brief §9: "associated with
// relevant MMKE entities").
model EntityEducationalContent {
  id                   String @id @default(uuid())
  entityType           String
  entityId             String
  educationalContentId String

  educationalContent EducationalContent @relation(fields: [educationalContentId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@map("entity_educational_content")
}

// ---------------------------------------------------------------------------
// Audit log (ADR §20) — append-only, written by every mutating repository
// call. Enforced as insert-only by application code in modules/audit
// (modules/db is the only place Prisma is imported — see ADR §3 boundary
// rule); a hard DB-level immutability trigger is a reasonable later
// hardening step, not required for the Phase 1 foundation.
// ---------------------------------------------------------------------------

model AuditLogEntry {
  id             String   @id @default(uuid())
  actorId        String?
  action         String
  entityType     String
  entityId       String
  beforeSnapshot Json?
  afterSnapshot  Json?
  timestamp      DateTime @default(now())

  actor StudioUser? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([timestamp])
  @@map("audit_log_entries")
}

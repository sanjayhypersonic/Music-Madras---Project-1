// Music Madras — Canonical MMKE Database Schema
//
// This is the ONE canonical persistent source of truth for the MMKE domain
// model, per docs/architecture/ADR-0001-production-platform.md (sections
// 4, 5, 6, 15, 16, 17).
//
// Phase 1 scope (see docs/phase-1-foundation.md for the full explanation):
//   - The core canonical catalogue entities (ADR §4).
//   - The Recording / RecordingRevision draft-and-publish model (ADR §5),
//     with exactly one normalized representation of a recording's content
//     at any point in time — no JSON shadow state, no draftPayload blob.
//   - The YouTubeVideo / YouTubePlaylist / YouTubePlaylistItem resource
//     tables, including their observabilityState column (ADR §15), because
//     MediaResource and Collection reference them. Their *behaviour*
//     (sync engine, field ownership, conflict resolution — ADR §11-16) is
//     explicitly NOT implemented in Phase 1.
//   - A minimal StudioUser table exists ONLY as the createdBy/updatedBy
//     foreign-key target the ADR's entity pattern requires. It has no
//     password/session/invitation fields — the full account lifecycle
//     (ADR §7) is a later phase. This is a deliberate scope note, not a
//     silent architecture change; see docs/phase-1-foundation.md.
//
// Explicitly OUT of scope for this schema (later phases, per the ADR):
//   - Session / Account / Invitation / PasswordResetToken (ADR §7) — added
//     in Phase 4, once Studio authentication was built.
//   - FieldOwnership / SyncConflict (ADR §16), ObservabilityTransition /
//     SyncPolicy (ADR §15), SyncCheckpoint / SyncJobRun (ADR §12, §13) —
//     added in Phase 6B as the persistence foundation the YouTube sync
//     engine will need. The sync engine itself (the API adapter,
//     reconciliation logic, deletion-evidence escalation, and Studio UI)
//     remains out of scope — these tables exist so that work can be built
//     without a further schema change, per ADR §12-16.

generator client {
  provider = "prisma-client-js"
}

// Connection URLs are configured in prisma.config.ts (Prisma ORM 7+),
// not here. The CLI (migrate/db push) uses DIRECT_URL; the application
// runtime uses DATABASE_URL (pooled) via a driver adapter in
// modules/db/client.ts. See ADR §6.3.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum StudioRole {
  FOUNDER
  SUPER_ADMINISTRATOR
  ADMINISTRATOR
  EDITOR
  REVIEWER
  CONTRIBUTOR
}

enum StudioUserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum RecordingAggregateStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum RevisionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum VenueType {
  CHURCH
  CATHEDRAL
  CONCERT_HALL
  STUDIO
  OUTDOOR
}

enum MediaProvider {
  YOUTUBE
  UPLOAD
}

enum MediaRole {
  PRIMARY_VIDEO
  THUMBNAIL
  POSTER
  PROGRAMME_PDF
  SHEET_MUSIC
  AUDIO_MASTER
}

enum ObservabilityState {
  OBSERVED
  NOT_OBSERVED
  PRIVATE
  UNLISTED
  UNAVAILABLE
  DELETED
  SYNC_ERROR
}

enum SheetMusicRequestStatus {
  NEW
  IN_REVIEW
  FULFILLED
  DECLINED
}

// Phase 2 (brief §8): a simple publish toggle for Collections, distinct
// from the Recording Draft & Revision model — Collections are curated
// groupings, not richly-authored content, so a full revision history
// would be over-engineering (and would risk becoming "another
// snapshot/versioning mechanism," which the Phase 2 brief explicitly
// rules out). Archival still uses the existing archivedAt column, for
// consistency with every other entity.
enum CollectionStatus {
  DRAFT
  PUBLISHED
}

// Phase 6G-1 (brief §1): same two-state shape as CollectionStatus, for the
// same reason — a YouTubeVideoPage is a thin catalogue/publication wrapper
// around synced facts, not richly-authored content, so it doesn't need
// Recording's full revision history. Archival is the existing archivedAt
// convention, not a third enum state.
enum VideoPageStatus {
  DRAFT
  PUBLISHED
}

// Phase 6G-17: same two-state shape as CollectionStatus/VideoPageStatus,
// for the same reason — a LearningGuide's free-form contentMarkdown body
// is written progressively in Studio, so "not archived" alone is never a
// defensible public-visibility signal (unlike a simple canonical entity
// such as Composer). Archival still uses the existing archivedAt column,
// orthogonally: archiving/restoring a LearningGuide never changes its
// status, and publishing/unpublishing never changes archivedAt — mirrors
// archiveCollection/restoreCollection exactly.
enum LearningGuideStatus {
  DRAFT
  PUBLISHED
}

// ---------------------------------------------------------------------------
// Studio identity (minimal — see file header note)
// ---------------------------------------------------------------------------

model StudioUser {
  id           String           @id @default(uuid())
  email        String           @unique
  name         String
  role         StudioRole
  status       StudioUserStatus @default(INVITED)
  // Phase 4: nullable because an account may exist before a password is
  // set (freshly invited, or a future Google-only account) — the ADR's
  // Credentials provider checks this directly; Auth.js's own "User" model
  // is deliberately NOT used for identity (see docs/phase-4-studio.md) so
  // there is exactly one user-identity table, not two.
  passwordHash String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  sessions            StudioSession[]
  accounts            StudioAccount[]
  invitationsSent     Invitation[]         @relation("InvitationInvitedBy")
  passwordResetTokens PasswordResetToken[]

  composersCreated          Composer[]                    @relation("ComposerCreatedBy")
  composersUpdated          Composer[]                    @relation("ComposerUpdatedBy")
  worksCreated              MusicalWork[]                 @relation("MusicalWorkCreatedBy")
  worksUpdated              MusicalWork[]                 @relation("MusicalWorkUpdatedBy")
  programmesCreated         Programme[]                   @relation("ProgrammeCreatedBy")
  programmesUpdated         Programme[]                   @relation("ProgrammeUpdatedBy")
  performancesCreated       Performance[]                 @relation("PerformanceCreatedBy")
  performancesUpdated       Performance[]                 @relation("PerformanceUpdatedBy")
  recordingsCreated         Recording[]                   @relation("RecordingCreatedBy")
  recordingsUpdated         Recording[]                   @relation("RecordingUpdatedBy")
  revisionsCreated          RecordingRevision[]           @relation("RevisionCreatedBy")
  revisionsUpdated          RecordingRevision[]           @relation("RevisionUpdatedBy")
  artistsCreated            Artist[]                      @relation("ArtistCreatedBy")
  artistsUpdated            Artist[]                      @relation("ArtistUpdatedBy")
  choirsCreated             Choir[]                       @relation("ChoirCreatedBy")
  choirsUpdated             Choir[]                       @relation("ChoirUpdatedBy")
  conductorsCreated         Conductor[]                   @relation("ConductorCreatedBy")
  conductorsUpdated         Conductor[]                   @relation("ConductorUpdatedBy")
  organisationsCreated      Organisation[]                @relation("OrganisationCreatedBy")
  organisationsUpdated      Organisation[]                @relation("OrganisationUpdatedBy")
  venuesCreated             Venue[]                       @relation("VenueCreatedBy")
  venuesUpdated             Venue[]                       @relation("VenueUpdatedBy")
  instrumentsCreated        Instrument[]                  @relation("InstrumentCreatedBy")
  instrumentsUpdated        Instrument[]                  @relation("InstrumentUpdatedBy")
  collectionsCreated        Collection[]                  @relation("CollectionCreatedBy")
  collectionsUpdated        Collection[]                  @relation("CollectionUpdatedBy")
  occasionsCreated          Occasion[]                    @relation("OccasionCreatedBy")
  occasionsUpdated          Occasion[]                    @relation("OccasionUpdatedBy")
  learningGuidesCreated     LearningGuide[]               @relation("LearningGuideCreatedBy")
  learningGuidesUpdated     LearningGuide[]               @relation("LearningGuideUpdatedBy")
  educationalContentCreated EducationalContent[]          @relation("EducationalContentCreatedBy")
  educationalContentUpdated EducationalContent[]          @relation("EducationalContentUpdatedBy")
  // Phase 6K-1 — typed site settings, editorial content lifecycle, notifications
  siteSettingsUpdated       SiteSetting[]                 @relation("SiteSettingUpdatedBy")
  editorialContentPublished EditorialContent[]            @relation("EditorialContentPublishedBy")
  editorialPublications     EditorialContentPublication[] @relation("EditorialPublicationActor")
  notificationReads         StudioNotificationRead[]
  notificationDeliveries    StudioNotificationDelivery[]
  videoExposureApproved     VideoExposureApproval[]       @relation("VideoExposureApprovedBy")
  videoExposureRevoked      VideoExposureApproval[]       @relation("VideoExposureRevokedBy")
  incidentsResolved         OperationalIncident[]         @relation("OperationalIncidentResolvedBy")
  videoExposureConfirmed    VideoExposureApproval[]       @relation("VideoExposureConfirmedBy")
  videoMetadataResolved     VideoMetadataChange[]         @relation("VideoMetadataChangeResolvedBy")
  videoReviewsDecided       VideoExposureReview[]         @relation("VideoReviewDecidedBy")
  videoReviewDecisionsMade  VideoExposureReviewDecision[] @relation("VideoReviewDecisionActor")
  featuredVideosPinned      FeaturedVideo[]               @relation("FeaturedVideoPinnedBy")
  playlistPagesCreated      PlaylistPage[]                @relation("PlaylistPageCreatedBy")
  playlistPagesUpdated      PlaylistPage[]                @relation("PlaylistPageUpdatedBy")
  playlistPagesPublished    PlaylistPage[]                @relation("PlaylistPagePublishedBy")
  playlistItemsAdded        PlaylistPageItem[]            @relation("PlaylistPageItemAddedBy")
  playlistPublications      PlaylistPagePublication[]     @relation("PlaylistPublicationActor")
  playlistInputsCreated     PlaylistContextInput[]        @relation("PlaylistInputCreatedBy")
  playlistInputsAnswered    PlaylistContextInput[]        @relation("PlaylistInputAnsweredBy")
  playlistInputsWithdrawn   PlaylistContextInput[]        @relation("PlaylistInputWithdrawnBy")
  playlistDraftsRequested   PlaylistDraftProposal[]       @relation("PlaylistDraftRequestedBy")
  playlistDraftsDecided     PlaylistDraftProposal[]       @relation("PlaylistDraftDecidedBy")
  editorialContentCreated   EditorialContent[]            @relation("EditorialContentCreatedBy")
  editorialContentUpdated   EditorialContent[]            @relation("EditorialContentUpdatedBy")
  videoPagesCreated         YouTubeVideoPage[]            @relation("YouTubeVideoPageCreatedBy")
  videoPagesUpdated         YouTubeVideoPage[]            @relation("YouTubeVideoPageUpdatedBy")
  auditLogEntries           AuditLogEntry[]               @relation("AuditLogActor")

  // Phase 6B (ADR §16.3) — an editor changing a synced field's ownership,
  // and an editor resolving a sync conflict, are both meaningful actorial
  // events, following the same createdBy/updatedBy-style convention as
  // every other entity above.
  fieldOwnershipChanges FieldOwnership[] @relation("FieldOwnershipChangedBy")
  syncConflictsResolved SyncConflict[]   @relation("SyncConflictResolvedBy")

  // Phase 6H-4 — Content Suggestion persistence: requesting a generation
  // attempt and reviewing its resulting suggestion are distinct actorial
  // events (system-side attempt vs. human review decision, docs/content-intelligence-architecture.md
  // Phase 6H-2 §24), so they get their own named relations rather than
  // reusing a generic createdBy/updatedBy pair.
  contentGenerationRequestsRequested ContentGenerationRequest[] @relation("ContentGenerationRequestedBy")
  contentSuggestionsReviewed         ContentSuggestion[]        @relation("ContentSuggestionReviewedBy")

  // Phase 6H-8 — explicit, authorized Source approval is its own actorial
  // event (never automatic — see SourceApprovalState above).
  sourcesApproved Source[] @relation("SourceApprovedBy")

  @@map("studio_users")
}

// ---------------------------------------------------------------------------
// Authentication (Phase 4, ADR §7) — session/OAuth-linkage bookkeeping only.
//
// These are NOT Auth.js's own generic "Session"/"Account" Prisma models.
// The off-the-shelf @auth/prisma-adapter hardcodes calls against models
// literally named User/Session/Account/VerificationToken (its documented
// @map() naming-convention support only renames columns/tables, not the
// Prisma Client model itself) — adopting it as-is would have required
// either renaming StudioUser to User throughout three already-completed
// phases, or maintaining a second, duplicate user-identity table (email/
// name held in both "User" and "StudioUser"), which this project has
// consistently avoided everywhere else (see e.g. the Venue/Organisation
// and MediaResource FK decisions in docs/phase-2-mmke-domain.md).
//
// Instead, modules/auth/ implements a custom Auth.js Adapter (an
// officially-supported extension point, not a workaround) against these
// two tables plus the existing StudioUser — see docs/phase-4-studio.md.
// No VerificationToken table exists because this project uses only the
// Credentials and (optional) Google OAuth providers, never Auth.js's
// email/magic-link provider, which is the only thing that model is for.
// ---------------------------------------------------------------------------

model StudioSession {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  studioUserId String
  expires      DateTime

  studioUser StudioUser @relation(fields: [studioUserId], references: [id], onDelete: Cascade)

  @@index([studioUserId])
  @@map("studio_sessions")
}

model StudioAccount {
  id                String  @id @default(uuid())
  studioUserId      String
  type              String // Auth.js AdapterAccount.type, e.g. "oauth"
  provider          String // e.g. "google"
  providerAccountId String
  refreshToken      String? @db.Text
  accessToken       String? @db.Text
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String? @db.Text
  sessionState      String?

  studioUser StudioUser @relation(fields: [studioUserId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([studioUserId])
  @@map("studio_accounts")
}

// ---------------------------------------------------------------------------
// Invitation & password reset (Phase 4, ADR §7) — Music Madras's own
// tables, unrelated to Auth.js. Studio is invite-only: there is no
// /studio/register route anywhere in app/(studio), and account creation
// only ever happens through modules/auth's invitation-acceptance flow.
// ---------------------------------------------------------------------------

model Invitation {
  id          String     @id @default(uuid())
  email       String
  role        StudioRole
  invitedById String
  // Only the hash is stored — the raw token exists only in the invite
  // link/email at issuance time, exactly like PasswordResetToken below.
  tokenHash   String     @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime   @default(now())

  invitedBy StudioUser @relation("InvitationInvitedBy", fields: [invitedById], references: [id])

  @@index([email])
  @@map("invitations")
}

model PasswordResetToken {
  id           String    @id @default(uuid())
  studioUserId String
  tokenHash    String    @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  studioUser StudioUser @relation(fields: [studioUserId], references: [id], onDelete: Cascade)

  @@index([studioUserId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Canonical catalogue — Composer / MusicalWork / Programme / Performance
// ---------------------------------------------------------------------------

model Composer {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  bornDate    String?
  diedDate    String?
  era         String?
  biography   String?   @db.Text
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String
  updatedById String

  createdBy StudioUser @relation("ComposerCreatedBy", fields: [createdById], references: [id])
  updatedBy StudioUser @relation("ComposerUpdatedBy", fields: [updatedById], references: [id])

  works          MusicalWork[]
  mediaResources MediaResource[]

  @@index([archivedAt])
  @@map("composers")
}

model MusicalWork {
  id              String    @id @default(uuid())
  slug            String    @unique
  title           String
  // Phase 2 additions (brief §5 — support the catalogue depth GAIS's own
  // CANONICAL_MODELS.md aspired to for Western Classical + related
  // choral/historical material, without assuming one musical tradition):
  alternateTitles String[]  @default([])
  language        String?
  notes           String?   @db.Text
  catalogueNumber String?
  keySignature    String?
  composerId      String
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String
  updatedById     String

  composer  Composer   @relation(fields: [composerId], references: [id], onDelete: Restrict)
  createdBy StudioUser @relation("MusicalWorkCreatedBy", fields: [createdById], references: [id])
  updatedBy StudioUser @relation("MusicalWorkUpdatedBy", fields: [updatedById], references: [id])

  programmeItems         ProgrammeItem[]
  recordingRevisionLinks RecordingRevisionWork[]
  sheetMusicRequests     SheetMusicRequest[]
  learningGuideLinks     LearningGuideWork[]
  collectionLinks        CollectionWork[]

  @@index([composerId])
  @@index([archivedAt])
  @@map("musical_works")
}

model Programme {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  notes       String?   @db.Text
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String
  updatedById String

  createdBy StudioUser @relation("ProgrammeCreatedBy", fields: [createdById], references: [id])
  updatedBy StudioUser @relation("ProgrammeUpdatedBy", fields: [updatedById], references: [id])

  items        ProgrammeItem[]
  performances Performance[]

  @@index([archivedAt])
  @@map("programmes")
}

model ProgrammeItem {
  id            String  @id @default(uuid())
  programmeId   String
  musicalWorkId String
  order         Int
  movement      String?
  isEncore      Boolean @default(false)

  programme   Programme   @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  musicalWork MusicalWork @relation(fields: [musicalWorkId], references: [id], onDelete: Restrict)

  @@unique([programmeId, order])
  @@index([musicalWorkId])
  @@map("programme_items")
}

model Performance {
  id              String    @id @default(uuid())
  // Phase 6G-8: added so Performance can have its own public
  // /performances/[slug] route, mirroring Composer/MusicalWork/Venue/
  // Programme/Recording. Derived once at creation from Programme title +
  // Venue name + performance date, plus this row's own id as a stable
  // uniqueness suffix (same shape as generateVideoSlug's title+immutable-id
  // pattern) — never regenerated afterward, even if the Programme, Venue,
  // date, or participants change later.
  slug            String    @unique
  programmeId     String
  venueId         String
  performanceDate DateTime?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String
  updatedById     String

  // Phase 6J-10F: set ONLY on a copy-on-write clone. When a Recording's draft needs to change the participants of a
  // Performance that a published revision also uses, the draft gets its own copy (this row) so the live page does not
  // change until publication; publishing copies the clone's participants back onto the original (keeping its slug and
  // public URL) and deletes the clone. Null on every ordinary Performance (all existing rows).
  draftOfPerformanceId     String?
  // A fingerprint (sha256) of the original's participants (performers with roles, choirs, conductors) at the moment this
  // clone was made. Promotion compares it with the original's participants at publication: if they differ, someone else
  // changed the original since, and the publication is refused instead of overwriting their change. Null on every
  // ordinary Performance.
  draftBaseParticipantsKey String?

  programme   Programme     @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  venue       Venue         @relation(fields: [venueId], references: [id], onDelete: Restrict)
  createdBy   StudioUser    @relation("PerformanceCreatedBy", fields: [createdById], references: [id])
  updatedBy   StudioUser    @relation("PerformanceUpdatedBy", fields: [updatedById], references: [id])
  draftOf     Performance?  @relation("PerformanceDraftClone", fields: [draftOfPerformanceId], references: [id], onDelete: SetNull)
  draftClones Performance[] @relation("PerformanceDraftClone")

  revisions   RecordingRevision[]
  instruments Instrument[]
  performers  PerformancePerformer[]
  choirs      PerformanceChoir[]
  conductors  PerformanceConductor[]

  @@index([programmeId])
  @@index([venueId])
  @@index([archivedAt])
  @@index([draftOfPerformanceId])
  @@map("performances")
}

// ---------------------------------------------------------------------------
// Participants and their join tables to Performance (ADR §4 — explicit
// relationships, not free-text strings)
// ---------------------------------------------------------------------------

model Artist {
  id          String    @id @default(uuid())
  // Phase 6G-9: added so Artist can have its own public /artists/[slug]
  // route, mirroring Composer/Venue's slugify(name) convention. New rows
  // get a clean slug via createArtist; existing rows were backfilled with
  // a name+id-suffix slug (see the phase6g9 migration) since a one-shot
  // SQL backfill across pre-existing rows can't safely resolve
  // name collisions the way a Studio editor can at create time. Never
  // regenerated after creation, even if the name is edited later.
  slug        String    @unique
  name        String
  instrument  String?
  biography   String?   @db.Text
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String
  updatedById String

  createdBy StudioUser @relation("ArtistCreatedBy", fields: [createdById], references: [id])
  updatedBy StudioUser @relation("ArtistUpdatedBy", fields: [updatedById], references: [id])

  performances PerformancePerformer[]

  @@map("artists")
}

model Choir {
  id           String    @id @default(uuid())
  // Phase 6G-9: see Artist.slug's comment above — identical rationale.
  slug         String    @unique
  name         String
  directorName String?
  description  String?   @db.Text
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String
  updatedById  String

  createdBy StudioUser @relation("ChoirCreatedBy", fields: [createdById], references: [id])
  updatedBy StudioUser @relation("ChoirUpdatedBy", fields: [updatedById], references: [id])

  performances PerformanceChoir[]

  @@map("choirs")
}

model Conductor {
  id          String    @id @default(uuid())
  // Phase 6G-9: see Artist.slug's comment above — identical rationale.
  slug        String    @unique
  name        String
  biography   String?   @db.Text
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String
  updatedById String

  createdBy StudioUser @relation("ConductorCreatedBy", fields: [createdById], references: [id])
  updatedBy StudioUser @relation("ConductorUpdatedBy", fields: [updatedById], references: [id])

  performances PerformanceConductor[]

  @@map("conductors")
}

model Organisation {
  id          String    @id @default(uuid())
  // Phase 6G-14: added so Organisation can have its own public
  // /organisations/[slug] route, mirroring Composer/Venue/Artist/Choir/
  // Conductor. Existing rows were backfilled from `name` (Artist/Choir/
  // Conductor's pattern — Organisation already had a real human-typed
  // name, unlike Performance) plus an id-suffix for guaranteed
  // uniqueness; every new row going forward gets a clean
  // slugify(name)-only slug with SlugConflictError on collision.
  slug        String    @unique
  name        String
  description String?   @db.Text
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String
  updatedById String

  createdBy StudioUser @relation("OrganisationCreatedBy", fields: [createdById], references: [id])
  updatedBy StudioUser @relation("OrganisationUpdatedBy", fields: [updatedById], references: [id])

  venues Venue[]

  @@map("organisations")
}

model PerformancePerformer {
  performanceId String
  artistId      String
  // Phase 2: e.g. "Soloist", "Organist", "Accompanist" — a free-text role
  // label kept deliberately simple (brief §6: "extensible for future
  // participant roles without creating an unnecessarily complex role
  // engine"). A controlled enum would need a migration for every new role
  // Music Madras wants to record; this does not.
  role          String?

  performance Performance @relation(fields: [performanceId], references: [id], onDelete: Cascade)
  artist      Artist      @relation(fields: [artistId], references: [id], onDelete: Restrict)

  @@id([performanceId, artistId])
  @@map("performance_performers")
}

model PerformanceChoir {
  performanceId String
  choirId       String

  performance Performance @relation(fields: [performanceId], references: [id], onDelete: Cascade)
  choir       Choir       @relation(fields: [choirId], references: [id], onDelete: Restrict)

  @@id([performanceId, choirId])
  @@map("performance_choirs")
}

model PerformanceConductor {
  performanceId String
  conductorId   String

  performance Performance @relation(fields: [performanceId], references: [id], onDelete: Cascade)
  conductor   Conductor   @relation(fields: [conductorId], references: [id], onDelete: Restrict)

  @@id([performanceId, conductorId])
  @@map("performance_conductors")
}

// ---------------------------------------------------------------------------
// Venue / Church (one table, per ADR §4) and Instrument
// ---------------------------------------------------------------------------

model Venue {
  id              String    @id @default(uuid())
  slug            String    @unique
  name            String
  type            VenueType
  address         String?
  city            String?
  country         String?
  capacity        Int?
  acousticProfile String?
  // Phase 2 (brief §7): a Church (or any Venue) may also be a meaningful
  // organisation/entity in the cultural catalogue — e.g. the congregation
  // or trust that operates the building, distinct from the physical place
  // itself, and potentially operating more than one venue over time. This
  // is deliberately the smallest justified addition: an OPTIONAL link,
  // not a merge of Venue and Organisation into one table (which would
  // wrongly conflate "a physical place" with "an institution") and not a
  // second Church-specific table (which would risk duplicate venue/church
  // records for the same building). See docs/phase-2-mmke-domain.md §7
  // for the full reasoning.
  organisationId  String?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String
  updatedById     String

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  createdBy    StudioUser    @relation("VenueCreatedBy", fields: [createdById], references: [id])
  updatedBy    StudioUser    @relation("VenueUpdatedBy", fields: [updatedById], references: [id])

  performances   Performance[]
  instruments    Instrument[]
  mediaResources MediaResource[]

  @@index([archivedAt])
  @@index([organisationId])
  @@map("venues")
}

model Instrument {
  id            String    @id @default(uuid())
  name          String
  manufacturer  String?
  buildYear     String?
  venueId       String
  performanceId String?
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String
  updatedById   String

  venue       Venue        @relation(fields: [venueId], references: [id], onDelete: Restrict)
  performance Performance? @relation(fields: [performanceId], references: [id], onDelete: SetNull)
  createdBy   StudioUser   @relation("InstrumentCreatedBy", fields: [createdById], references: [id])
  updatedBy   StudioUser   @relation("InstrumentUpdatedBy", fields: [updatedById], references: [id])

  @@index([venueId])
  @@map("instruments")
}

// ---------------------------------------------------------------------------
// Recording identity + Draft/Revision model (ADR §5 — the one canonical
// representation; no JSON shadow state, no draftPayload)
// ---------------------------------------------------------------------------

model Recording {
  id                         String                   @id @default(uuid())
  slug                       String                   @unique
  status                     RecordingAggregateStatus @default(DRAFT)
  currentDraftRevisionId     String?                  @unique
  currentPublishedRevisionId String?                  @unique
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  createdById                String
  updatedById                String

  createdBy StudioUser @relation("RecordingCreatedBy", fields: [createdById], references: [id])
  updatedBy StudioUser @relation("RecordingUpdatedBy", fields: [updatedById], references: [id])

  // Pointers into the revision history below. Nullable and SetNull on
  // delete because these are pointers, not ownership — the true ownership
  // FK is RecordingRevision.recordingId (Cascade), the reverse direction.
  currentDraftRevision     RecordingRevision? @relation("RecordingCurrentDraft", fields: [currentDraftRevisionId], references: [id], onDelete: SetNull)
  currentPublishedRevision RecordingRevision? @relation("RecordingCurrentPublished", fields: [currentPublishedRevisionId], references: [id], onDelete: SetNull)

  revisions          RecordingRevision[]      @relation("RecordingRevisions")
  sheetMusicRequests SheetMusicRequest[]
  collectionLinks    CollectionRecording[]
  learningGuideLinks LearningGuideRecording[]

  @@map("recordings")
}

model RecordingRevision {
  id             String         @id @default(uuid())
  recordingId    String
  revisionNumber Int
  revisionStatus RevisionStatus @default(DRAFT)

  // Core content — see ADR §5.1. This IS the canonical representation;
  // there is no parallel JSON document anywhere holding the same data.
  title       String?
  description String? @db.Text

  performanceId String?
  performance   Performance? @relation(fields: [performanceId], references: [id], onDelete: SetNull)

  // SEO fields (ADR §19) — distinct, real columns; not a duplicate
  // representation of catalogue data, just revision-specific metadata.
  seoMetaTitle       String?
  seoMetaDescription String? @db.Text
  seoCanonicalPath   String?

  // Educational content fields (ADR §4 Studio wizard "Educational" step).
  educationalDifficultyLevel String?
  educationalListeningGuide  String? @db.Text
  educationalAnalysis        String? @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  updatedById String

  recording Recording  @relation("RecordingRevisions", fields: [recordingId], references: [id], onDelete: Cascade)
  createdBy StudioUser @relation("RevisionCreatedBy", fields: [createdById], references: [id])
  updatedBy StudioUser @relation("RevisionUpdatedBy", fields: [updatedById], references: [id])

  // Reverse side of Recording.currentDraftRevisionId / currentPublishedRevisionId.
  currentDraftOf     Recording? @relation("RecordingCurrentDraft")
  currentPublishedOf Recording? @relation("RecordingCurrentPublished")

  works          RecordingRevisionWork[]
  mediaResources MediaResource[]

  // Phase 6J-11B / 6L — revision-scoped relationships: written by recordingRevisionRelationshipsRepository (and copied by the fork), read by
  // recordingRelationshipReadersRepository (Organisation page, AI context, Studio). The legacy Recording-level EntitySource/EntityRights/EntityOccasion
  // rows (entityType "RECORDING") are frozen history: nothing writes or reads them.
  sourceLinks   RecordingRevisionSource[]
  rightsLinks   RecordingRevisionRights[]
  occasionLinks RecordingRevisionOccasion[]

  @@unique([recordingId, revisionNumber])
  @@index([performanceId])
  @@map("recording_revisions")
}

model RecordingRevisionWork {
  revisionId              String
  musicalWorkId           String
  order                   Int
  catalogueNumberOverride String?

  revision    RecordingRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  musicalWork MusicalWork       @relation(fields: [musicalWorkId], references: [id], onDelete: Restrict)

  @@id([revisionId, musicalWorkId])
  @@map("recording_revision_works")
}

// ---------------------------------------------------------------------------
// Phase 6J-11B — revision-scoped Recording relationships (foundation).
//
// A RecordingRevision's own sources, rights information and occasions: child rows of the revision, like
// RecordingRevisionWork. They are copied to the new draft when a published revision is forked and are edited only on
// an editable draft, so a draft's changes cannot reach a published revision. The Source, RightsInformation and
// Occasion rows themselves stay shared catalogue identities (never copied).
//
// Integrity: composite primary keys prevent duplicate links; the revision FK cascades (a revision's links go with it);
// the catalogue FKs are RESTRICT (a Source/RightsInformation/Occasion that a revision uses cannot be deleted from under
// it — the application has no delete path for them anyway). The legacy Recording-level rows (EntitySource/
// EntityRights/EntityOccasion with entityType "RECORDING") are frozen since Phase 6L: kept as history (and as the input of the rollback
// re-projection), never written or read by the application.
// ---------------------------------------------------------------------------

model RecordingRevisionSource {
  revisionId String
  sourceId   String
  createdAt  DateTime @default(now())

  revision RecordingRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  source   Source            @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@id([revisionId, sourceId])
  @@index([sourceId])
  @@map("recording_revision_sources")
}

model RecordingRevisionRights {
  revisionId          String
  rightsInformationId String
  createdAt           DateTime @default(now())

  revision          RecordingRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  rightsInformation RightsInformation @relation(fields: [rightsInformationId], references: [id], onDelete: Restrict)

  @@id([revisionId, rightsInformationId])
  @@index([rightsInformationId])
  @@map("recording_revision_rights")
}

model RecordingRevisionOccasion {
  revisionId String
  occasionId String
  createdAt  DateTime @default(now())

  revision RecordingRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  occasion Occasion          @relation(fields: [occasionId], references: [id], onDelete: Restrict)

  @@id([revisionId, occasionId])
  @@index([occasionId])
  @@map("recording_revision_occasions")
}

// ---------------------------------------------------------------------------
// Collections (replaces the prototype's ad-hoc Playlist type — ADR §4/§14)
// ---------------------------------------------------------------------------

model Collection {
  id                String           @id @default(uuid())
  slug              String           @unique
  title             String
  description       String?          @db.Text
  status            CollectionStatus @default(DRAFT)
  backingPlaylistId String?
  archivedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  createdById       String
  updatedById       String

  backingPlaylist YouTubePlaylist? @relation(fields: [backingPlaylistId], references: [id], onDelete: SetNull)
  createdBy       StudioUser       @relation("CollectionCreatedBy", fields: [createdById], references: [id])
  updatedBy       StudioUser       @relation("CollectionUpdatedBy", fields: [updatedById], references: [id])

  recordingLinks CollectionRecording[]
  workLinks      CollectionWork[]
  mediaResources MediaResource[]

  @@index([archivedAt])
  @@map("collections")
}

model CollectionRecording {
  collectionId String
  recordingId  String
  order        Int

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  recording  Recording  @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@id([collectionId, recordingId])
  @@map("collection_recordings")
}

model CollectionWork {
  collectionId  String
  musicalWorkId String
  order         Int

  collection  Collection  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  musicalWork MusicalWork @relation(fields: [musicalWorkId], references: [id], onDelete: Cascade)

  @@id([collectionId, musicalWorkId])
  @@map("collection_works")
}

// ---------------------------------------------------------------------------
// Occasion (Phase 6G-12) — a canonical cultural, liturgical, ceremonial,
// seasonal, or contextual circumstance (Christmas, Easter, a Wedding, ...)
// associated with a Programme/Performance/Recording/Collection. A simple
// direct-edit entity, following the exact Composer/Venue/Artist/Choir/
// Conductor precedent — not part of the Draft/Revision model.
//
// Deliberately distinct from Collection: Collection is editorial curation
// (a specific grouping of recordings/works an editor chose to assemble);
// Occasion is a controlled contextual dimension (why/when in the cultural
// calendar). A Collection MAY be built around an Occasion, but the two are
// never interchangeable and neither model is renamed/merged into the
// other.
// ---------------------------------------------------------------------------

model Occasion {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  description String?   @db.Text
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String
  updatedById String

  createdBy StudioUser @relation("OccasionCreatedBy", fields: [createdById], references: [id])
  updatedBy StudioUser @relation("OccasionUpdatedBy", fields: [updatedById], references: [id])

  entityLinks   EntityOccasion[]
  // Phase 6J-11B: the revisions that carry this occasion (revision-scoped links).
  revisionLinks RecordingRevisionOccasion[]

  @@index([archivedAt])
  @@map("occasions")
}

// ---------------------------------------------------------------------------
// Educational content, Learning guides, Editorial content
// ---------------------------------------------------------------------------

model LearningGuide {
  id                          String              @id @default(uuid())
  slug                        String              @unique
  title                       String
  difficultyLevel             String?
  contentMarkdown             String?             @db.Text
  estimatedReadingTimeMinutes Int?
  status                      LearningGuideStatus @default(DRAFT)
  archivedAt                  DateTime?
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  createdById                 String
  updatedById                 String

  createdBy StudioUser @relation("LearningGuideCreatedBy", fields: [createdById], references: [id])
  updatedBy StudioUser @relation("LearningGuideUpdatedBy", fields: [updatedById], references: [id])

  workLinks      LearningGuideWork[]
  recordingLinks LearningGuideRecording[]
  mediaResources MediaResource[]

  @@index([archivedAt])
  @@map("learning_guides")
}

model LearningGuideWork {
  learningGuideId String
  musicalWorkId   String

  learningGuide LearningGuide @relation(fields: [learningGuideId], references: [id], onDelete: Cascade)
  musicalWork   MusicalWork   @relation(fields: [musicalWorkId], references: [id], onDelete: Cascade)

  @@id([learningGuideId, musicalWorkId])
  @@map("learning_guide_works")
}

model LearningGuideRecording {
  learningGuideId String
  recordingId     String

  learningGuide LearningGuide @relation(fields: [learningGuideId], references: [id], onDelete: Cascade)
  recording     Recording     @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@id([learningGuideId, recordingId])
  @@map("learning_guide_recordings")
}

// A smaller, reusable educational content unit (ADR §4 lists this
// separately from LearningGuide but does not detail its shape beyond one
// line). Kept deliberately minimal — no public route/slug is specified
// for it in ADR §3, unlike LearningGuide's `/learning/[slug]`.
model EducationalContent {
  id          String    @id @default(uuid())
  title       String
  body        String?   @db.Text
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String
  updatedById String

  createdBy StudioUser @relation("EducationalContentCreatedBy", fields: [createdById], references: [id])
  updatedBy StudioUser @relation("EducationalContentUpdatedBy", fields: [updatedById], references: [id])

  // Phase 2: generic attachment to any MMKE entity (see EntityEducationalContent).
  linkedEntities EntityEducationalContent[]

  @@map("educational_content")
}

model EditorialContent {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  body        String?   @db.Text
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String
  updatedById String

  createdBy      StudioUser      @relation("EditorialContentCreatedBy", fields: [createdById], references: [id])
  updatedBy      StudioUser      @relation("EditorialContentUpdatedBy", fields: [updatedById], references: [id])
  mediaResources MediaResource[]

  // Phase 6K-1 — draft/publish lifecycle for site-level editorial copy (homepage introduction, story, section introductions,
  // footer tagline, site SEO). The draft columns above are edited freely; the PUBLISHED SNAPSHOT columns below are the only
  // thing the public site reads, so a draft edit can never silently change the live website. `version` counts draft edits
  // (optimistic concurrency); `publishedVersion` is the draft version that was published.
  status                  EditorialContentStatus @default(DRAFT)
  seoTitle                String?
  seoDescription          String?                @db.Text
  version                 Int                    @default(1)
  publishedTitle          String?
  publishedBody           String?                @db.Text
  publishedSeoTitle       String?
  publishedSeoDescription String?                @db.Text
  publishedVersion        Int?
  publishedAt             DateTime?
  publishedById           String?

  publishedBy  StudioUser?                   @relation("EditorialContentPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  publications EditorialContentPublication[]

  @@index([archivedAt])
  @@map("editorial_content")
}

// ---------------------------------------------------------------------------
// Media (ADR §4, §18) — explicit nullable FK per attachable parent type,
// rather than an unconstrained polymorphic (type, id) pair, so referential
// integrity is real.
// ---------------------------------------------------------------------------

model MediaResource {
  id                 String        @id @default(uuid())
  provider           MediaProvider
  // Fallback for providers without a canonical table yet (e.g. a future
  // Vimeo/Spotify adapter). When provider = YOUTUBE, prefer the real
  // youtubeVideoId relation below instead — Phase 1 only had this loose
  // string, which was exactly the "free text instead of a relationship"
  // gap the Phase 2 relationship review flagged (ADR §3's Recording ->
  // YouTubeVideo chain).
  providerResourceId String?
  role               MediaRole
  url                String?

  recordingRevisionId String?
  composerId          String?
  venueId             String?
  collectionId        String?
  learningGuideId     String?
  editorialContentId  String?
  youtubeVideoId      String?
  rightsInformationId String?

  recordingRevision RecordingRevision? @relation(fields: [recordingRevisionId], references: [id], onDelete: Cascade)
  composer          Composer?          @relation(fields: [composerId], references: [id], onDelete: Cascade)
  venue             Venue?             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  collection        Collection?        @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  learningGuide     LearningGuide?     @relation(fields: [learningGuideId], references: [id], onDelete: Cascade)
  editorialContent  EditorialContent?  @relation(fields: [editorialContentId], references: [id], onDelete: Cascade)
  // Phase 2: real relationship instead of a bare string.
  youtubeVideo      YouTubeVideo?      @relation(fields: [youtubeVideoId], references: [id], onDelete: SetNull)
  // Phase 2: rights-aware by construction (ADR §17/§10).
  rightsInformation RightsInformation? @relation(fields: [rightsInformationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recordingRevisionId])
  @@index([youtubeVideoId])
  @@index([rightsInformationId])
  @@map("media_resources")
}

// ---------------------------------------------------------------------------
// YouTube resource tables — schema only (ADR §4 explicitly requires these
// as foundations). No sync engine, adapter, ownership, or conflict logic
// is implemented in Phase 1; see ADR §11-16 for that design.
// ---------------------------------------------------------------------------

model YouTubeVideo {
  id                  String             @id @default(uuid())
  youtubeVideoId      String             @unique
  title               String?
  description         String?            @db.Text
  thumbnailUrl        String?
  publishedAt         DateTime?
  durationSeconds     Int?
  etag                String?
  contentHash         String?
  observabilityState  ObservabilityState @default(OBSERVED)
  // Phase 6F additions — the Phase 1 schema predated the Data API adapter
  // (Phase 6C) and its statistics/status fields (Phase 6E), so it never
  // had columns for them. All four are purely additive, nullable, and
  // named to match the adapter's own YouTubeVideoRecord DTO exactly.
  // channelId/embeddable/privacyStatus are technical facts the sync
  // engine always overwrites (never FieldOwnership-tracked, ADR §16.1
  // only names title/description/thumbnailUrl/visibilityStatus for this
  // table). The three current* counters plus statisticsUpdatedAt are
  // YouTube's own mutable, frequently-refreshed signals (brief §9) — a
  // plain "value as of the last sync" column, not a time-series; deeper
  // historical/analytical trends remain YouTubeAnalyticsObservation's job
  // above, a distinct and already-existing table.
  channelId           String?
  privacyStatus       String?
  embeddable          Boolean?
  currentViewCount    Int?
  currentLikeCount    Int?
  currentCommentCount Int?
  statisticsUpdatedAt DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  playlistItems         YouTubePlaylistItem[]
  mediaResources        MediaResource[]
  analyticsObservations YouTubeAnalyticsObservation[]
  videoPage             YouTubeVideoPage?
  exposureReview        VideoExposureReview?

  @@map("youtube_videos")
}

model YouTubePlaylist {
  id                 String             @id @default(uuid())
  youtubePlaylistId  String             @unique
  title              String?
  description        String?            @db.Text
  etag               String?
  contentHash        String?
  observabilityState ObservabilityState @default(OBSERVED)
  // Phase 6F additions — same rationale as YouTubeVideo above: this table
  // never had columns for the playlist's own channel, thumbnail,
  // publish date, or privacy status, all of which the Phase 6F initial
  // synchronization brief requires be preserved and kept refreshable.
  channelId          String?
  thumbnailUrl       String?
  privacyStatus      String?
  publishedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  items        YouTubePlaylistItem[]
  collections  Collection[]
  playlistPage PlaylistPage?

  @@map("youtube_playlists")
}

model YouTubePlaylistItem {
  id                 String             @id @default(uuid())
  playlistId         String
  youtubeVideoId     String
  position           Int
  etag               String?
  observabilityState ObservabilityState @default(OBSERVED)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  playlist YouTubePlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  video    YouTubeVideo    @relation(fields: [youtubeVideoId], references: [id], onDelete: Cascade)

  @@unique([playlistId, youtubeVideoId])
  @@index([playlistId, position])
  @@map("youtube_playlist_items")
}

// Phase 6G-1 — the Music Madras-owned catalogue/publication wrapper for a
// single synchronized YouTubeVideo (pre-flight §4). YouTubeVideo above
// remains a pure synchronization mirror: nothing on it is editorial, and
// this model never writes to it. A row here represents an explicit editor
// decision to give one specific video a canonical Music Madras page — the
// 226 synced videos do NOT each get one automatically (brief "IMPORTANT").
// Deliberately no duplicated title/description/thumbnail/statistics copy —
// those are always read live from the linked YouTubeVideo relation.
model YouTubeVideoPage {
  id                            String          @id @default(uuid())
  slug                          String          @unique
  youtubeVideoId                String          @unique
  status                        VideoPageStatus @default(DRAFT)
  // Music Madras editorial content, distinct from YouTube's own
  // title/description (which stay on YouTubeVideo, YouTube-controlled).
  curatorNote                   String?         @db.Text
  seoMetaTitle                  String?
  seoMetaDescription            String?         @db.Text
  // Phase 6G-2A — explicit Music Madras editorial approval for exposing an
  // UNLISTED YouTube video's page publicly. The timestamp itself IS the
  // approval record (non-null = approved, null = not approved) — no
  // separate boolean, no separate approval table. Only ever meaningful
  // when the linked YouTubeVideo.privacyStatus is "unlisted"; a "private"
  // video has no approval path at all (modules/mmke/catalogue/
  // isYouTubeVideoPagePublic.ts never even reads this field for that
  // case). Approving does not publish, and publishing does not approve —
  // these are two independent editor decisions.
  unlistedPublicationApprovedAt DateTime?
  archivedAt                    DateTime?
  createdAt                     DateTime        @default(now())
  updatedAt                     DateTime        @updatedAt
  createdById                   String
  updatedById                   String
  // Phase 6K lifecycle hardening (F12) — the YouTube-side metadata an editor last reviewed for an APPROVED page (the normalised material fields,
  // see modules/mmke/catalogue/metadataFingerprint.ts), and when. A later difference is recorded as a pending VideoMetadataChange; it never
  // revokes the approval by itself. NULL until a baseline is recorded (at approval, or the first observation of an already approved page).
  metadataReviewedSnapshot      Json?
  metadataReviewedAt            DateTime?

  youtubeVideo YouTubeVideo @relation(fields: [youtubeVideoId], references: [id], onDelete: Cascade)
  createdBy    StudioUser   @relation("YouTubeVideoPageCreatedBy", fields: [createdById], references: [id])
  updatedBy    StudioUser   @relation("YouTubeVideoPageUpdatedBy", fields: [updatedById], references: [id])

  // Phase 6K-2 — recorded, scoped, revocable exposure approvals (used only for UNLISTED videos).
  exposureApprovals VideoExposureApproval[]
  featured          FeaturedVideo?
  playlistItems     PlaylistPageItem[]
  metadataChanges   VideoMetadataChange[]

  @@index([archivedAt])
  @@map("youtube_video_pages")
}

// ---------------------------------------------------------------------------
// YouTube Analytics observations (Phase 3, brief §8-11) — normalized,
// synchronized performance measurements from the YouTube Analytics API.
// This is deliberately a *different* table from YouTubeVideo/Playlist
// above: those answer "what exists" (YouTube Data API); this answers "how
// is it performing" (YouTube Analytics API). YouTube Analytics remains
// authoritative for these numbers — this table stores synchronized
// observations, not a competing source of truth.
//
// One row per (scope, target, metric, period, dimension breakdown) rather
// than one enormous row with a nullable column per possible metric —
// avoids both the "one giant table" anti-pattern and a full data
// warehouse. `dimensions` is a small JSON breakdown (e.g.
// {"trafficSource":"YT_SEARCH"} or {"country":"IN","device":"MOBILE"})
// because YouTube Analytics reports can be sliced by an open-ended
// combination of dimensions (brief §8) — this is NOT the "JSON shadow
// state" the project has been careful to avoid elsewhere, because there is
// no ambiguity about a second source of truth: this JSON only ever holds
// a reporting breakdown, never catalogue identity. `dimensionsHash` is a
// deterministic hash of the canonicalized `dimensions` JSON, used because
// Prisma/Postgres unique constraints are far more reliable on a plain
// scalar column than directly on a JSON column — this is what makes
// re-running a sync idempotent (brief §10).
// ---------------------------------------------------------------------------

enum YouTubeAnalyticsScope {
  CHANNEL
  VIDEO
}

enum YouTubeAnalyticsMetric {
  VIEWS
  WATCH_TIME_MINUTES
  AVERAGE_VIEW_DURATION_SECONDS
  AVERAGE_VIEW_PERCENTAGE
  LIKES
  COMMENTS
  SHARES
  SUBSCRIBERS_GAINED
  SUBSCRIBERS_LOST
}

model YouTubeAnalyticsObservation {
  id             String                 @id @default(uuid())
  scope          YouTubeAnalyticsScope
  // Postgres treats NULL as distinct from every other NULL in a unique
  // constraint, so a nullable youtubeVideoId/channelId pair cannot safely
  // sit inside @@unique below — two CHANNEL-scoped rows (where
  // youtubeVideoId is null) would never collide and idempotency would
  // silently break for exactly that scope. targetKey is a non-null
  // application-computed value (youtubeVideoId when scope = VIDEO,
  // channelId when scope = CHANNEL) used ONLY for uniqueness.
  // youtubeVideoId/channelId below remain the real, nullable columns used
  // for actual relational queries and joins.
  targetKey      String
  youtubeVideoId String? // the real FK, set when scope = VIDEO
  channelId      String? // the external YouTube channel id; set when scope = CHANNEL,
  // and also optionally stamped on VIDEO-scoped rows for convenient
  // channel-wide queries. No dedicated YouTubeChannel table yet — Music
  // Madras has exactly one channel today, so a full entity would be
  // premature; add one if/when a second channel or richer channel
  // metadata is actually needed.
  metric         YouTubeAnalyticsMetric
  periodStart    DateTime
  periodEnd      DateTime
  value          Float
  dimensions     Json? // optional reporting breakdown — see note above
  dimensionsHash String                 @default("") // canonicalized hash of `dimensions`; "" when there is none

  // Loose forward-reference, not a foreign key: SyncJobRun (ADR §12-13)
  // does not exist yet (deferred to the phase that builds the YouTube Data
  // sync engine). This becomes a real FK once that table exists, rather
  // than introducing a second, analytics-specific job-run table now.
  syncJobRunId String?
  source       String   @default("youtube_analytics_api")
  syncedAt     DateTime @default(now())

  video YouTubeVideo? @relation(fields: [youtubeVideoId], references: [id], onDelete: Cascade)

  @@unique([scope, targetKey, metric, periodStart, periodEnd, dimensionsHash])
  @@index([youtubeVideoId, metric, periodStart])
  @@index([channelId, metric, periodStart])
  @@map("youtube_analytics_observations")
}

// ---------------------------------------------------------------------------
// YouTube Sync Foundation (Phase 6B, ADR §12, §13, §15, §16) — the
// persistence/domain foundation the approved YouTube synchronization
// architecture depends on. No API adapter, reconciliation logic,
// deletion-evidence escalation, scheduler, or Studio UI is implemented
// here — these six tables exist so that work can be built without a
// further schema change, per ADR §12-16.
//
// Generic across resource types (and, eventually, providers) via
// SyncProvider/SyncResourceType — the same (resourceType, resourceId)
// string-pair pattern already used above for EntitySource/EntityRights/
// EntityEducationalContent, rather than a per-type foreign key, since one
// FieldOwnership/ObservabilityTransition row can describe a Recording, a
// YouTubeVideo, a YouTubePlaylist, or a YouTubePlaylistItem. No existing
// YouTube table (YouTubeVideo/YouTubePlaylist/YouTubePlaylistItem),
// MediaResource, Collection, Recording, or RecordingRevision is modified.
// ---------------------------------------------------------------------------

enum SyncProvider {
  YOUTUBE
}

// RECORDING is included alongside the raw YouTube resource types because
// ADR §16.1 explicitly extends field ownership to Recording.title/
// description — the fields most likely to originate from an ingested
// YouTubeVideo and then be edited editorially.
enum SyncResourceType {
  RECORDING
  YOUTUBE_VIDEO
  YOUTUBE_PLAYLIST
  YOUTUBE_PLAYLIST_ITEM
}

// Three persisted states. ADR §16.2 also names a fourth state,
// MUSIC_MADRAS_EDITORIAL, for fields with no YouTube-sourced counterpart
// at all (e.g. a future analysisMarkdown) — but the ADR itself says "no
// FieldOwnership row is even needed for such fields," so it was never a
// value this enum has to store: a field either never enters this table at
// all, or is one of the three states below.
enum FieldOwnershipState {
  YOUTUBE_CONTROLLED
  MUSIC_MADRAS_CONTROLLED
  SHARED_REQUIRES_REVIEW
}

enum SyncConflictStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum SyncConflictResolution {
  KEPT_MUSIC_MADRAS
  ACCEPTED_YOUTUBE
  MANUAL_MERGE
}

// ADR §13.2: a run only counts as deletion/unavailability evidence when
// FULL — a PARTIAL (or FAILED, tracked on SyncJobRun.status instead) run
// contributes no such evidence either way.
enum SyncCompleteness {
  FULL
  PARTIAL
}

enum SyncJobStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

// One row per (provider, resourceType, resourceId, fieldName) — ADR
// §16.1's single generic ownership mechanism, not a titleSource/
// descriptionSource column pair duplicated per entity.
model FieldOwnership {
  id                 String              @id @default(uuid())
  provider           SyncProvider
  resourceType       SyncResourceType
  resourceId         String
  fieldName          String
  ownership          FieldOwnershipState @default(YOUTUBE_CONTROLLED)
  lastExternalValue  String?             @db.Text
  lastEditorialValue String?             @db.Text
  lastSyncedAt       DateTime?
  // Distinct from `updatedAt`, which Prisma bumps on every write to this
  // row (including a routine `lastExternalValue`/`lastSyncedAt` sync
  // touch) — this column answers "when did the ownership *state itself*
  // last change" specifically, alongside who/what changed it below.
  ownershipChangedAt DateTime            @default(now())
  changedById        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  changedBy StudioUser? @relation("FieldOwnershipChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@unique([provider, resourceType, resourceId, fieldName])
  @@index([resourceType, resourceId])
  @@map("field_ownerships")
}

// ADR §16.3's conflict record. previousMusicMadrasValue/newProviderValue
// capture exactly what conflicted, so the Music Madras value is preserved
// and visible, never silently overwritten (a later phase's Studio review
// screen is what an editor resolves this from — not built here).
model SyncConflict {
  id                       String                  @id @default(uuid())
  provider                 SyncProvider
  resourceType             SyncResourceType
  resourceId               String
  fieldName                String
  ownershipAtDetection     FieldOwnershipState
  previousMusicMadrasValue String?                 @db.Text
  newProviderValue         String?                 @db.Text
  status                   SyncConflictStatus      @default(OPEN)
  resolution               SyncConflictResolution?
  reason                   String?
  detectedAt               DateTime                @default(now())
  resolvedAt               DateTime?
  resolvedById             String?
  syncJobRunId             String?

  resolvedBy StudioUser? @relation("SyncConflictResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  syncJobRun SyncJobRun? @relation(fields: [syncJobRunId], references: [id], onDelete: SetNull)

  @@index([resourceType, resourceId])
  @@index([status])
  @@map("sync_conflicts")
}

// ADR §15's evidence record behind an availability state transition.
// Reuses the existing ObservabilityState enum unchanged — it already
// covers every state §15 specifies; nothing about it needed to change.
model ObservabilityTransition {
  id                    String             @id @default(uuid())
  provider              SyncProvider
  resourceType          SyncResourceType
  resourceId            String
  musicMadrasEntityType String?
  musicMadrasEntityId   String?
  fromState             ObservabilityState
  toState               ObservabilityState
  reason                String
  requiredPasses        Int?
  syncJobRunId          String?
  syncCheckpointId      String?
  detectedAt            DateTime           @default(now())

  syncJobRun     SyncJobRun?     @relation(fields: [syncJobRunId], references: [id], onDelete: SetNull)
  syncCheckpoint SyncCheckpoint? @relation(fields: [syncCheckpointId], references: [id], onDelete: SetNull)

  @@index([resourceType, resourceId])
  @@index([toState])
  @@map("observability_transitions")
}

// ADR §15's deletionEvidenceRequiredPasses, held as configuration rather
// than a literal constant in application code — one typed row per
// (provider, resourceType), not a generic key/value settings table, since
// this is the one setting this phase actually needs.
model SyncPolicy {
  id                             String           @id @default(uuid())
  provider                       SyncProvider
  resourceType                   SyncResourceType
  deletionEvidenceRequiredPasses Int              @default(3)
  isActive                       Boolean          @default(true)
  createdAt                      DateTime         @default(now())
  updatedAt                      DateTime         @updatedAt

  @@unique([provider, resourceType])
  @@map("sync_policies")
}

// ADR §13.2. One row per (provider, resourceType, scopeKey) — scopeKey is
// the generic analogue of the ADR's "(resourceType, parentId)" (e.g. a
// specific playlist's id when paging its items, or a fixed sentinel like
// "channel-uploads" when paging the channel's uploads playlist).
// providerCursor is a small, genuinely provider-specific escape hatch for
// paging details that don't fit the normalized columns above — never
// catalogue data, only resumption bookkeeping.
model SyncCheckpoint {
  id                   String            @id @default(uuid())
  provider             SyncProvider
  resourceType         SyncResourceType
  scopeKey             String
  pageToken            String?
  lastProcessedId      String?
  etag                 String?
  lastFullCompletionAt DateTime?
  completeness         SyncCompleteness?
  providerCursor       Json?
  syncJobRunId         String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  syncJobRun               SyncJobRun?               @relation(fields: [syncJobRunId], references: [id], onDelete: SetNull)
  observabilityTransitions ObservabilityTransition[]

  @@unique([provider, resourceType, scopeKey])
  @@map("sync_checkpoints")
}

// ADR §12-13's SyncJobRun — one row per actual synchronization attempt,
// scheduled or manual alike (both will call the same job function in a
// later phase, so both write this same row shape). recordsFlagged
// mirrors ADR §13.4's own wording ("counts of created/updated/flagged/
// failed resources per type") — one collective counter for anything
// landing on PRIVATE/UNLISTED/UNAVAILABLE/DELETED, since the per-resource
// detail already lives in ObservabilityTransition; this column is a
// dashboard summary number, not a second source of truth for it.
model SyncJobRun {
  id                String            @id @default(uuid())
  provider          SyncProvider
  jobType           String
  status            SyncJobStatus     @default(RUNNING)
  completeness      SyncCompleteness?
  startedAt         DateTime          @default(now())
  completedAt       DateTime?
  recordsDiscovered Int               @default(0)
  recordsCreated    Int               @default(0)
  recordsUpdated    Int               @default(0)
  recordsUnchanged  Int               @default(0)
  recordsFlagged    Int               @default(0)
  recordsFailed     Int               @default(0)
  conflictsDetected Int               @default(0)
  errorDetails      String?           @db.Text

  checkpoints              SyncCheckpoint[]
  observabilityTransitions ObservabilityTransition[]
  syncConflicts            SyncConflict[]

  @@index([provider, status])
  @@index([startedAt])
  @@map("sync_job_runs")
}

// ---------------------------------------------------------------------------
// Sheet Music Requests (ADR §17)
// ---------------------------------------------------------------------------

model SheetMusicRequest {
  id                String                  @id @default(uuid())
  requesterName     String
  requesterEmail    String
  musicalWorkId     String?
  recordingId       String?
  instrumentOrVoice String?
  intendedUse       String?
  message           String?                 @db.Text
  status            SheetMusicRequestStatus @default(NEW)
  consentGivenAt    DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  musicalWork MusicalWork? @relation(fields: [musicalWorkId], references: [id], onDelete: SetNull)
  recording   Recording?   @relation(fields: [recordingId], references: [id], onDelete: SetNull)

  @@index([musicalWorkId])
  @@index([status])
  @@map("sheet_music_requests")
}

// ---------------------------------------------------------------------------
// Provenance — Source / Citation / RightsInformation (ADR §4), attached to
// any entity via a generic entityType/entityId join, exactly as the ADR
// itself specifies this one as a genuinely generic/polymorphic case.
// ---------------------------------------------------------------------------

// Phase 6H-8 — a Source's trust/approval state for automated Content
// Intelligence evidence retrieval (docs/content-intelligence-architecture.md,
// Phase 6H-8 section). This is orthogonal to the existing source-tier
// classification (ContextSourceType's CANONICAL_MMKE/YOUTUBE_METADATA/
// APPROVED_EDITORIAL/APPROVED_EXTERNAL_SOURCE, defined in
// modules/mmke/contentIntelligence/recordingContextContract.ts) — that map
// says which TIER a source belongs to; this enum says whether a given
// APPROVED_EXTERNAL_SOURCE-tier Source has actually been reviewed and
// trusted yet. UNREVIEWED is the default for every new (and, after this
// migration, every pre-existing) Source: nothing becomes AI-eligible
// automatically.
enum SourceApprovalState {
  UNREVIEWED
  APPROVED
  REJECTED
  DISABLED
}

model Source {
  id        String   @id @default(uuid())
  title     String?
  url       String?
  publisher String?
  createdAt DateTime @default(now())

  // Phase 6H-8 — see SourceApprovalState above. approvedById/approvedAt
  // record who/when explicitly approved this Source; lastRetrievedAt/
  // contentFingerprint exist so a retrieval adapter can detect that an
  // approved source's underlying content changed, without a separate
  // scheduler or version table (brief: "establish the data model necessary
  // to record retrievedAt / content fingerprint", deferring the scheduler
  // itself).
  approvalState      SourceApprovalState @default(UNREVIEWED)
  approvedById       String?
  approvedAt         DateTime?
  lastRetrievedAt    DateTime?
  contentFingerprint String?

  approvedBy StudioUser? @relation("SourceApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  citations     Citation[]
  entityLinks   EntitySource[]
  // Phase 6J-11B
  revisionLinks RecordingRevisionSource[]

  @@map("sources")
}

model Citation {
  id        String   @id @default(uuid())
  text      String?  @db.Text
  sourceId  String?
  createdAt DateTime @default(now())

  source Source? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@map("citations")
}

model RightsInformation {
  id          String   @id @default(uuid())
  holder      String?
  licenseType String?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())

  // Direct link for the common case (a specific media asset's rights —
  // ADR §17's "attaching a MediaResource... with its own RightsInformation").
  mediaResources MediaResource[]
  // Phase 6J-11B: the revisions that carry this rights record (revision-scoped links).
  revisionLinks  RecordingRevisionRights[]
  // Generic link for entity-level rights (e.g. a MusicalWork's copyright
  // status, independent of any one recording of it) — Phase 2, mirrors
  // EntitySource's pattern.
  entityLinks    EntityRights[]

  @@map("rights_information")
}

model EntitySource {
  id         String @id @default(uuid())
  entityType String
  entityId   String
  sourceId   String

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@map("entity_sources")
}

// Generic entity-level rights attachment (Phase 2) — mirrors EntitySource
// exactly, per ADR §10's rights-aware-publishing foundation. Used for
// rights that belong to an entity itself (e.g. a MusicalWork's copyright
// status) rather than to one specific MediaResource (which has its own
// direct rightsInformationId instead).
model EntityRights {
  id                  String @id @default(uuid())
  entityType          String
  entityId            String
  rightsInformationId String

  rightsInformation RightsInformation @relation(fields: [rightsInformationId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@map("entity_rights")
}

// Generic entity-level educational content attachment (Phase 2) — mirrors
// EntitySource/EntityRights. Lets an EducationalContent block contextualize
// any entity (a Recording, a MusicalWork, a Composer, ...) without a
// dedicated join table per entity type (brief §9: "associated with
// relevant MMKE entities").
model EntityEducationalContent {
  id                   String @id @default(uuid())
  entityType           String
  entityId             String
  educationalContentId String

  educationalContent EducationalContent @relation(fields: [educationalContentId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@map("entity_educational_content")
}

// Generic entity-level Occasion attachment (Phase 6G-12) — mirrors
// EntitySource/EntityRights/EntityEducationalContent exactly: entityType
// stays a plain string (never a database enum), so the V1-supported set
// (PROGRAMME/PERFORMANCE/RECORDING/COLLECTION — enforced in
// modules/mmke/occasion/occasionEntityType.ts) can grow later without a
// migration. Deliberately excludes Work and Video: a MusicalWork is
// occasion-agnostic (the same setting can be performed at any service),
// and a Video's context is always derived transitively through its
// canonical Recording (the same single-source-of-truth pattern
// isRecordingPublished/isYouTubeVideoPagePublic already establish), never
// a second, independently-driftable link.
//
// @@unique guarantees a given entity cannot attach the same Occasion
// twice (brief §3). onDelete: Cascade on the Occasion relation is a
// database-level safety net only — application code never hard-deletes an
// Occasion (archive/restore only, mirroring Composer), so this should
// never fire in normal operation.
model EntityOccasion {
  id         String @id @default(uuid())
  entityType String
  entityId   String
  occasionId String

  occasion Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)

  @@unique([entityType, entityId, occasionId])
  @@index([entityType, entityId])
  @@index([occasionId])
  @@map("entity_occasions")
}

// ---------------------------------------------------------------------------
// Content Suggestion persistence (Phase 6H-4, docs/content-intelligence-architecture.md
// Phase 6H-2 §33/§37). This is the persistent editorial layer a future
// Content Intelligence generator will populate — NOT built here. No LLM
// integration exists anywhere in this codebase; these two tables only give
// a proposed editorial change somewhere durable to live while a human
// reviews it.
//
// Two models, deliberately not one and not three (6H-2 §33):
// - ContentGenerationRequest is the system-side attempt record, mirroring
//   SyncJobRun's own separation of "did the job run" from the rows it
//   produces (modules/db/repositories/syncJobRunRepository.ts).
// - ContentSuggestion is the human-reviewable artifact. Collapsing the two
//   would conflate "did the AI call succeed" with "did the editor accept
//   it" — genuinely different lifecycles with different actors.
// A third model (a suggestion revision/edit-history table) is explicitly
// NOT included — the first pilot needs only one proposal per generation
// request; `finalContent` below already preserves the distinction between
// what was generated and what an editor approved instead, without a
// separate versioning table.
//
// `targetEntityType`/`targetEntityId` reuse the exact generic string-pair
// pattern EntitySource/EntityRights/EntityOccasion already established
// above — not a new polymorphic framework. The V1-supported set is
// exactly one value, `"RECORDING"`, enforced at the application layer in
// modules/mmke/contentIntelligence/contentSuggestionEntityType.ts (never a
// database enum, so it can grow later without a migration, mirroring
// provenanceEntityType.ts's convention exactly).
//
// PUBLISHED is deliberately NOT a ContentSuggestionStatus value: approval
// only means a human has accepted the proposal, or their edited version of
// it, for eventual editorial use — publication remains entirely the job of
// whatever existing publish mechanism governs the real target field (e.g.
// Recording's own publishCurrentDraft), never duplicated here.
enum ContentSuggestionType {
  EDITORIAL_PROSE
  SEO_METADATA
  INTERNAL_LINK
  INFORMATION_GAP
  SOURCE_LEAD
  SEARCH_TERMINOLOGY
  // A candidate relationship change (e.g. "this video may correspond to
  // Work X") — never auto-applied. No code path in this phase, or any
  // future one, may let accepting this suggestion type itself create or
  // modify an MMKE relationship; only a human using the existing
  // catalogue-write UI can actually do that.
  CANONICAL_RELATIONSHIP_CANDIDATE
}

enum ContentGenerationStatus {
  PENDING
  GENERATING
  SUCCEEDED
  FAILED
}

enum ContentSuggestionStatus {
  DRAFT_READY
  EDITOR_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

enum ContentSuggestionReviewDecision {
  ACCEPT
  EDIT_AND_ACCEPT
  REJECT_UNSUPPORTED
  REJECT_INCORRECT
  REJECT_DUPLICATE
  REJECT_OTHER
}

model ContentGenerationRequest {
  id               String @id @default(uuid())
  targetEntityType String
  targetEntityId   String

  suggestionType ContentSuggestionType
  status         ContentGenerationStatus @default(PENDING)

  // A deterministic fingerprint of the RecordingContext (Phase 6H-3) this
  // request was generated against — the minimum mechanism for staleness
  // detection (6H-2 §31): never a full context snapshot, never a stored
  // percentage/score.
  contextFingerprint String?

  // Generation/model metadata (6H-2 §30) — reproducibility/auditability
  // only. No provider is integrated in this phase; these stay null until
  // a future phase actually calls one. Never a place for secrets/API keys.
  provider      String?
  model         String?
  promptVersion String?

  requestedById String
  requestedAt   DateTime  @default(now())
  completedAt   DateTime?
  errorDetails  String?   @db.Text

  requestedBy StudioUser          @relation("ContentGenerationRequestedBy", fields: [requestedById], references: [id])
  suggestions ContentSuggestion[]

  @@index([targetEntityType, targetEntityId])
  @@map("content_generation_requests")
}

model ContentSuggestion {
  id                  String @id @default(uuid())
  generationRequestId String

  suggestionType   ContentSuggestionType
  targetEntityType String
  targetEntityId   String
  // The specific editorial field this proposal targets once approved,
  // e.g. "educationalListeningGuide" — null for suggestion types with no
  // single field target (INFORMATION_GAP, SEARCH_TERMINOLOGY,
  // CANONICAL_RELATIONSHIP_CANDIDATE).
  targetField      String?

  // The proposal as originally produced — plain text for prose-shaped
  // types, JSON-serialized text for structured types (e.g.
  // INFORMATION_GAP's missingField/whyItMatters/candidateResolutionSource/
  // requestedAction, docs/content-intelligence-architecture.md Phase 6H-2
  // §27). Immutable after creation — an editor's edit goes in
  // `finalContent` below, never here (brief: "do not overwrite the
  // original suggestion when an editor modifies it").
  proposedContent String @db.Text

  // References only — {sourceType, entityType, entityId, field} (6H-2
  // §22). Never a duplicated copy of the referenced record.
  evidenceRefs Json

  status ContentSuggestionStatus @default(DRAFT_READY)

  reviewedById   String?
  reviewDecision ContentSuggestionReviewDecision?
  reviewNote     String?                          @db.Text
  // The editor's own final wording, populated only when reviewDecision is
  // EDIT_AND_ACCEPT — proposedContent above is never overwritten.
  finalContent   String?                          @db.Text
  reviewedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  generationRequest ContentGenerationRequest @relation(fields: [generationRequestId], references: [id], onDelete: Cascade)
  reviewedBy        StudioUser?              @relation("ContentSuggestionReviewedBy", fields: [reviewedById], references: [id])

  @@index([targetEntityType, targetEntityId])
  @@index([status])
  @@map("content_suggestions")
}

// ---------------------------------------------------------------------------
// Audit log (ADR §20) — append-only, written by every mutating repository
// call. Enforced as insert-only by application code in modules/audit
// (modules/db is the only place Prisma is imported — see ADR §3 boundary
// rule); a hard DB-level immutability trigger is a reasonable later
// hardening step, not required for the Phase 1 foundation.
// ---------------------------------------------------------------------------

model AuditLogEntry {
  id             String   @id @default(uuid())
  actorId        String?
  action         String
  entityType     String
  entityId       String
  beforeSnapshot Json?
  afterSnapshot  Json?
  timestamp      DateTime @default(now())

  actor StudioUser? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([timestamp])
  @@map("audit_log_entries")
}

// ---------------------------------------------------------------------------
// Phase 6K-1 — site settings, editorial publication history, notifications.
// ---------------------------------------------------------------------------

enum EditorialContentStatus {
  DRAFT
  PUBLISHED
}

enum EditorialPublicationKind {
  PUBLISHED
  UNPUBLISHED
}

/// One row per publish or unpublish of an EditorialContent block: the exact snapshot that became (or stopped being) public.
model EditorialContentPublication {
  id             String                   @id @default(uuid())
  contentId      String
  kind           EditorialPublicationKind
  version        Int
  title          String
  body           String?                  @db.Text
  seoTitle       String?
  seoDescription String?                  @db.Text
  actorId        String
  createdAt      DateTime                 @default(now())

  content EditorialContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  actor   StudioUser       @relation("EditorialPublicationActor", fields: [actorId], references: [id])

  @@index([contentId, createdAt])
  @@map("editorial_content_publications")
}

/// Typed site/editorial setting VALUES. The definitions (name, type, default, validation, owner, who may change it) live in code
/// (modules/settings/settingsRegistry.ts); a row is only ever written for a key the registry defines, and a stored value that no
/// longer validates is ignored in favour of the default. Never holds a secret. `version` is an optimistic-concurrency counter.
model SiteSetting {
  key           String   @id
  valueJson     Json
  schemaVersion Int      @default(1)
  version       Int      @default(1)
  updatedAt     DateTime @updatedAt
  updatedById   String

  updatedBy StudioUser @relation("SiteSettingUpdatedBy", fields: [updatedById], references: [id])

  @@map("site_settings")
}

enum NotificationSeverity {
  INFO
  ACTION_REQUIRED
  WARNING
}

enum NotificationStatus {
  OPEN
  RESOLVED
}

enum NotificationChannel {
  IN_STUDIO
  EMAIL
}

enum NotificationDeliveryStatus {
  DELIVERED
  PENDING
  FAILED
  SKIPPED
}

/// An in-Studio notification about ONE distinct condition. `dedupeKey` is unique: raising the same condition again never creates a
/// second row, and re-notifies only when `contentFingerprint` shows the condition materially changed. `audienceAction` is the
/// StudioAction a user needs in order to see it.
model StudioNotification {
  id                 String               @id @default(uuid())
  kind               String
  dedupeKey          String               @unique
  severity           NotificationSeverity
  title              String
  body               String               @db.Text
  href               String?
  audienceAction     String
  contentFingerprint String?
  status             NotificationStatus   @default(OPEN)
  occurrenceCount    Int                  @default(1)
  firstRaisedAt      DateTime             @default(now())
  lastRaisedAt       DateTime             @default(now())
  resolvedAt         DateTime?
  resolvedReason     String?

  reads      StudioNotificationRead[]
  deliveries StudioNotificationDelivery[]

  @@index([status, audienceAction])
  @@map("studio_notifications")
}

model StudioNotificationRead {
  notificationId String
  userId         String
  readAt         DateTime @default(now())

  notification StudioNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         StudioUser         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@map("studio_notification_reads")
}

/// What was actually done to deliver a notification to a person on a channel: never "delivered" unless it was.
model StudioNotificationDelivery {
  id                String                     @id @default(uuid())
  notificationId    String
  channel           NotificationChannel
  recipientUserId   String
  status            NotificationDeliveryStatus @default(PENDING)
  attempts          Int                        @default(0)
  lastAttemptAt     DateTime?
  nextAttemptAt     DateTime?
  reason            String?
  /// A worker CLAIMS a delivery before sending: while claimedUntil is in the future no other worker will take it, and the claim token proves which
  /// worker may record the outcome. An expired claim (a crashed worker) is simply retaken. Delivery is therefore at-least-once, never exactly-once.
  claimedUntil      DateTime?
  claimToken        String?
  /// The notification was raised again (a new episode) while a worker held the claim: the claim stays valid, and once the in-flight send is recorded
  /// the delivery returns to PENDING so the newer text is sent too.
  requeueAfterClaim Boolean                    @default(false)
  /// Non-sensitive description of the last failure (an error class and a bounded, scrubbed message); never credentials, addresses or message bodies.
  lastError         String?
  lastErrorAt       DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  notification StudioNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  recipient    StudioUser         @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel, recipientUserId])
  @@index([status, nextAttemptAt])
  @@map("studio_notification_deliveries")
}

// ---------------------------------------------------------------------------
// Phase 6K lifecycle hardening (F10) — durable state of the scheduled stewardship job. Nothing here chooses a scheduler: whatever calls
// /api/cron/stewardship leaves a record, so Studio can say when the job last ran, which step failed and why, and whether it has stopped running.
// ---------------------------------------------------------------------------

enum StewardshipRunStatus {
  RUNNING
  /// Every step succeeded.
  SUCCEEDED
  /// At least one step failed and at least one succeeded (or the run lost its lease part-way).
  PARTIAL
  /// Every step failed.
  FAILED
  /// The run stopped reporting (its lease expired while RUNNING) and was closed by a later run.
  ABANDONED
}

enum StewardshipStepStatus {
  RUNNING
  SUCCEEDED
  /// The step did part of its work: some batches completed and others failed (or its time budget ran out). Not a success, not a total failure.
  PARTIAL
  FAILED
  /// Not started: the run lost its lease or was stopped first.
  SKIPPED
}

model StewardshipRun {
  id         String               @id @default(uuid())
  trigger    String
  status     StewardshipRunStatus @default(RUNNING)
  startedAt  DateTime             @default(now())
  finishedAt DateTime?

  steps StewardshipStepRun[]

  @@index([startedAt])
  @@map("stewardship_runs")
}

model StewardshipStepRun {
  id           String                @id @default(uuid())
  runId        String
  step         String
  status       StewardshipStepStatus @default(RUNNING)
  startedAt    DateTime              @default(now())
  finishedAt   DateTime?
  /// Counts only (items examined, changed, batches, batches that failed ...): never titles, addresses or other content.
  counts       Json?
  /// An error class and a bounded, scrubbed message for the failure: never a connection string, credential, address or stack trace.
  errorKind    String?
  errorSummary String?

  run StewardshipRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([step, startedAt])
  @@map("stewardship_step_runs")
}

// ---------------------------------------------------------------------------
// Operational incidents (project register R-15, first slice) — a durable, deduplicated record of integrity problems the platform detects at run time
// and works around (today: a Recording whose revision data is inconsistent is omitted from the public Organisation page). One row per distinct problem
// (kind + fingerprint), counted and timestamped instead of one row per occurrence. NOTHING FREE-FORM IS EVER STORED: the kind is an enum, the reason is a
// bounded code, the subject is an entity type code and an internal id. Visible only to administrators (Studio -> Health).
// ---------------------------------------------------------------------------

enum OperationalIncidentKind {
  ORGANISATION_PAGE_RECORDING_OMITTED
}

enum OperationalIncidentStatus {
  OPEN
  RESOLVED
}

model OperationalIncident {
  id              String                    @id @default(uuid())
  kind            OperationalIncidentKind
  /// sha256 (first 32 hex) of kind + reason code + subject: the same problem always maps to the same row.
  fingerprint     String
  status          OperationalIncidentStatus @default(OPEN)
  /// A bounded code such as PUBLISHED_REVISION_NOT_PUBLISHED. Never text from an exception.
  reasonCode      String
  /// A code such as "Recording" and the internal id of the affected row, when the incident is about one.
  subjectType     String?
  subjectId       String?
  occurrenceCount Int                       @default(1)
  firstSeenAt     DateTime                  @default(now())
  lastSeenAt      DateTime                  @default(now())
  resolvedAt      DateTime?
  resolvedById    String?
  resolvedReason  String?
  /// When a recurrence of this incident last had its administrator notification evaluated (the claim that stops a flood).
  lastNotifiedAt  DateTime?

  resolvedBy StudioUser? @relation("OperationalIncidentResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([kind, fingerprint])
  @@index([status, lastSeenAt])
  @@map("operational_incidents")
}

/// A named lease so overlapping invocations cannot run the job twice at once. A lease expires by itself (a crashed run never blocks the next one).
model StewardshipLease {
  name        String   @id
  holder      String
  leaseUntil  DateTime
  acquiredAt  DateTime @default(now())
  heartbeatAt DateTime @default(now())

  @@map("stewardship_leases")
}

// ---------------------------------------------------------------------------
// Phase 6K-2 — explicit, scoped, recorded exposure of UNLISTED YouTube videos, and the review queue that decides it.
//
// Five things are kept distinct: (1) YouTube visibility (YouTubeVideo.privacyStatus, owned by the sync); (2) whether a Music Madras
// page exists (YouTubeVideoPage); (3) whether that page is approved/published (YouTubeVideoPage.status, plus — for an unlisted
// video — an active PAGE approval); (4) whether the video is approved for a specific public playlist (PLAYLIST approval);
// (5) whether it may appear on discovery surfaces: catalogue, search, sitemap, homepage, featured (DISCOVERY approval).
// An approval is never inferred from YouTube playlist membership or from any setting, and revoking one changes nothing on YouTube.
// ---------------------------------------------------------------------------

enum VideoExposureScope {
  PAGE
  DISCOVERY
  PLAYLIST
}

/// A recorded approval (or revocation) of one scope of public exposure for one video page. Rows are never deleted: revocation sets
/// revokedAt. At most one ACTIVE approval per (videoPageId, scope, playlistPageId) is enforced in code under a row lock on the page AND in the
/// database by the partial unique index video_exposure_approvals_one_active_target_key (raw SQL in migration 20261022120000: Prisma cannot
/// express a partial index, so it is not declared here).
model VideoExposureApproval {
  id             String                     @id @default(uuid())
  videoPageId    String
  scope          VideoExposureScope
  /// Set only for PLAYLIST scope: the Music Madras playlist page this approval applies to.
  playlistPageId String?
  /// Who approved. NULL only for an approval carried over from the old single flag, which recorded no approver: the platform never guesses one.
  approvedById   String?
  approvedAt     DateTime                   @default(now())
  note           String?                    @db.Text
  revokedById    String?
  revokedAt      DateTime?
  revokeNote     String?                    @db.Text
  /// Why it was revoked, so Studio can tell an editor's decision from a lifecycle invalidation (the video went private, the page was archived).
  revokedReason  VideoExposureRevokeReason?
  /// Who made this approval: an editor deciding in Studio, or the platform carrying a legacy approval over (6K-fix).
  origin         VideoExposureOrigin        @default(EDITOR)
  /// For a carried-over approval: when (and by whom) an editor reconsidered it and chose to keep it. Null = not yet reconsidered.
  confirmedAt    DateTime?
  confirmedById  String?

  confirmedBy  StudioUser?      @relation("VideoExposureConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  videoPage    YouTubeVideoPage @relation(fields: [videoPageId], references: [id], onDelete: Cascade)
  playlistPage PlaylistPage?    @relation(fields: [playlistPageId], references: [id], onDelete: Restrict)
  approvedBy   StudioUser?      @relation("VideoExposureApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  revokedBy    StudioUser?      @relation("VideoExposureRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([videoPageId, scope])
  @@index([scope, revokedAt])
  @@map("video_exposure_approvals")
}

/// Why an approval was revoked. EDITOR and REVIEW_DECISION and HOLD are people's decisions; VIDEO_PRIVATE, VIDEO_UNAVAILABLE and PAGE_ARCHIVED are
/// lifecycle invalidations (the approval no longer describes the video's situation, so a FRESH approval is needed); RECONCILED and MIGRATION are
/// housekeeping by the platform. VIDEO_UNAVAILABLE is RETIRED: no code writes it (an unavailable or deleted video is hidden by the exposure rule but
/// keeps its approvals); the value stays only because removing an enum value needs a migration and any row carrying it is history.
enum VideoExposureRevokeReason {
  EDITOR
  REVIEW_DECISION
  HOLD
  VIDEO_PRIVATE
  VIDEO_UNAVAILABLE

  PAGE_ARCHIVED
  RECONCILED
  MIGRATION
}

/// Where an approval came from. EDITOR: a person approved it in Studio. MIGRATED_LEGACY: carried over by the migration from the old single
/// approval flag so nothing was delisted. RECONCILED_LEGACY: carried over by the reconciliation procedure from a flag set by an earlier
/// version of the software. The two legacy origins appear in Studio for reconsideration (confirm, or withdraw).
enum VideoExposureOrigin {
  EDITOR
  MIGRATED_LEGACY
  RECONCILED_LEGACY
}

enum VideoMetadataChangeStatus {
  /// A material change was detected after approval and no editor has looked at it yet. The page stays public meanwhile.
  PENDING
  /// An editor reviewed the changed metadata and accepted it.
  ACKNOWLEDGED
  /// The metadata went back to what was reviewed, so there is nothing to review.
  REVERTED
  /// The approval ended (revoked, or lifecycle invalidation) before the change was reviewed, so the review no longer applies.
  VOIDED
}

/// One detected material change to an approved page's YouTube-side metadata, from first detection to resolution. At most one PENDING row exists per
/// page (partial unique index video_metadata_changes_one_pending_key, raw SQL in migration 20261022110000); further changes while it is pending update
/// it instead of creating another, so repeated syncs never multiply reviews.
model VideoMetadataChange {
  id                  String                    @id @default(uuid())
  videoPageId         String
  status              VideoMetadataChangeStatus @default(PENDING)
  /// Fingerprint of what was last reviewed, and of what is there now.
  baselineFingerprint String
  observedFingerprint String
  /// Names of the material fields that differ from what was reviewed (title, description, thumbnail, ...).
  changedFields       String[]
  /// For each changed field: the reviewed value and the current value, shortened, so an editor sees what changed without opening YouTube.
  changeSummary       Json?
  detectedAt          DateTime                  @default(now())
  lastObservedAt      DateTime                  @default(now())
  resolvedAt          DateTime?
  resolvedById        String?
  resolutionNote      String?                   @db.Text

  videoPage  YouTubeVideoPage @relation(fields: [videoPageId], references: [id], onDelete: Cascade)
  resolvedBy StudioUser?      @relation("VideoMetadataChangeResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([videoPageId, status])
  @@index([status, detectedAt])
  @@map("video_metadata_changes")
}

enum VideoReviewState {
  PENDING
  INFO_REQUESTED
  DEFERRED
  DECLINED
  APPROVED
}

enum VideoExposureHold {
  RIGHTS
  COPYRIGHT
  PRIVACY
  OTHER
}

enum VideoReviewDecisionKind {
  APPROVE
  REQUEST_INFO
  DEFER
  DECLINE
  REVOKE
  /// A rights/copyright/privacy hold was recorded (earlier versions stored this as DECLINE).
  HOLD_SET
  /// A hold was cleared (earlier versions stored this as REQUEST_INFO).
  HOLD_CLEARED
}

/// The review state of one unlisted video (keyed by YouTubeVideo.id). `proposalFingerprint` hashes the facts that matter to the
/// decision, so an unchanged item is never surfaced again as new and a changed one is. A `holdReason` (rights, copyright, ...) blocks
/// approval until a person clears it.
model VideoExposureReview {
  id                  String             @id @default(uuid())
  youtubeVideoId      String             @unique
  state               VideoReviewState   @default(PENDING)
  proposalFingerprint String
  deferUntil          DateTime?
  infoRequest         String?            @db.Text
  holdReason          VideoExposureHold?
  holdNote            String?            @db.Text
  decidedById         String?
  decidedAt           DateTime?
  firstSurfacedAt     DateTime           @default(now())
  lastSurfacedAt      DateTime           @default(now())
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  youtubeVideo YouTubeVideo                  @relation(fields: [youtubeVideoId], references: [id], onDelete: Cascade)
  decidedBy    StudioUser?                   @relation("VideoReviewDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decisions    VideoExposureReviewDecision[]

  @@index([state, deferUntil])
  @@map("video_exposure_reviews")
}

/// The history of decisions on a review: who decided what, when, and with what note and scopes.
model VideoExposureReviewDecision {
  id        String                  @id @default(uuid())
  reviewId  String
  kind      VideoReviewDecisionKind
  note      String?                 @db.Text
  scopes    Json?
  actorId   String
  createdAt DateTime                @default(now())

  review VideoExposureReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  actor  StudioUser          @relation("VideoReviewDecisionActor", fields: [actorId], references: [id])

  @@index([reviewId, createdAt])
  @@map("video_exposure_review_decisions")
}

/// An editorially PINNED featured video (Phase 6K-3). Featured content is hybrid: pinned rows come first, in `position` order, and any
/// remaining slots are filled automatically from the shared eligible set (modules/mmke/featured). A pin never overrides eligibility: a
/// pinned video that is no longer listable (draft, archived, private, unavailable, approval revoked, on hold) is simply not shown, and
/// Studio says so. Unfeaturing deletes the row (the audit log keeps the history).
model FeaturedVideo {
  id          String   @id @default(uuid())
  videoPageId String   @unique
  /// 1..n, unique: reordering renumbers in two phases (see featuredVideoRepository.ts) so a legitimate multi-row reorder never trips it.
  position    Int      @unique
  note        String?  @db.Text
  pinnedById  String
  pinnedAt    DateTime @default(now())

  videoPage YouTubeVideoPage @relation(fields: [videoPageId], references: [id], onDelete: Cascade)
  pinnedBy  StudioUser       @relation("FeaturedVideoPinnedBy", fields: [pinnedById], references: [id])

  @@map("featured_videos")
}

enum PlaylistPageStatus {
  DRAFT
  PUBLISHED
}

/// A Music Madras PLAYLIST PAGE (Phase 6K-4): a curated, editorial page about a themed set of videos. It is NOT a mirror of a YouTube playlist —
/// membership (`items`) is curated here and is a separate fact from YouTube's own playlist membership, which grants nothing. The draft columns are
/// edited freely; the `published*` snapshot (including the member list) is the only thing the public site reads. A page may be published only
/// when the CURRENT draft passes the configurable quality rubric; a page that fails stays a draft.
model PlaylistPage {
  id                      String             @id @default(uuid())
  slug                    String             @unique
  /// Optional provenance: the synced YouTube playlist this page was started from.
  youtubePlaylistId       String?            @unique
  status                  PlaylistPageStatus @default(DRAFT)
  title                   String
  summary                 String?            @db.Text
  body                    String?            @db.Text
  seoTitle                String?
  seoDescription          String?            @db.Text
  /// Counts draft edits, including membership changes (optimistic concurrency; publishing names the version reviewed).
  version                 Int                @default(1)
  archivedAt              DateTime?
  publishedTitle          String?
  publishedSummary        String?            @db.Text
  publishedBody           String?            @db.Text
  publishedSeoTitle       String?
  publishedSeoDescription String?            @db.Text
  /// Ordered video-page ids at publish time.
  publishedMemberIds      Json?
  /// The editor's per-member notes AS PUBLISHED ({ videoPageId: note }). The public page reads notes from here, never from the editable draft rows.
  publishedMemberNotes    Json?
  /// The texts of the human-supplied context that stood behind the page when it was published (NULL for a page published before this was recorded).
  publishedContextTexts   Json?
  /// The normalised published title, set only while the page is published and not archived. Unique, so two pages can never be live under the same
  /// title even if both publish at the same moment (NULLs do not collide). Maintained by playlistPageRepository.
  publishedTitleKey       String?            @unique
  publishedVersion        Int?
  publishedAt             DateTime?
  publishedById           String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  createdById             String
  updatedById             String

  youtubePlaylist   YouTubePlaylist?          @relation(fields: [youtubePlaylistId], references: [id], onDelete: SetNull)
  createdBy         StudioUser                @relation("PlaylistPageCreatedBy", fields: [createdById], references: [id])
  updatedBy         StudioUser                @relation("PlaylistPageUpdatedBy", fields: [updatedById], references: [id])
  publishedBy       StudioUser?               @relation("PlaylistPagePublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  items             PlaylistPageItem[]
  publications      PlaylistPagePublication[]
  exposureApprovals VideoExposureApproval[]
  contextInputs     PlaylistContextInput[]
  draftProposals    PlaylistDraftProposal[]

  @@index([status, archivedAt])
  @@map("playlist_pages")
}

/// One curated member of a playlist page, in order.
model PlaylistPageItem {
  id             String   @id @default(uuid())
  playlistPageId String
  videoPageId    String
  position       Int
  note           String?  @db.Text
  addedById      String
  addedAt        DateTime @default(now())

  playlistPage PlaylistPage     @relation(fields: [playlistPageId], references: [id], onDelete: Cascade)
  videoPage    YouTubeVideoPage @relation(fields: [videoPageId], references: [id], onDelete: Cascade)
  addedBy      StudioUser       @relation("PlaylistPageItemAddedBy", fields: [addedById], references: [id])

  @@unique([playlistPageId, videoPageId])
  /// Positions are 1..n and unique per playlist page; reordering renumbers in two phases so it never trips this (see playlistPageRepository.ts).
  @@unique([playlistPageId, position])
  @@map("playlist_page_items")
}

/// Every publish and unpublish of a playlist page, with the exact snapshot, so what was live at any time is reconstructable.
model PlaylistPagePublication {
  id             String                   @id @default(uuid())
  playlistPageId String
  kind           EditorialPublicationKind
  version        Int
  snapshot       Json
  actorId        String
  createdAt      DateTime                 @default(now())

  playlistPage PlaylistPage @relation(fields: [playlistPageId], references: [id], onDelete: Cascade)
  actor        StudioUser   @relation("PlaylistPublicationActor", fields: [actorId], references: [id])

  @@index([playlistPageId, createdAt])
  @@map("playlist_page_publications")
}

enum PlaylistInputSource {
  AI_QUESTION
  EDITOR_NOTE
}

enum PlaylistInputStatus {
  AWAITING_ANSWER
  ACTIVE
  SKIPPED
  WITHDRAWN
}

/// Context a PERSON has supplied about a playlist page: an answer to an interview question (the AI proposes one question at a time; it never
/// supplies answers) or a note an editor wrote. Only ACTIVE inputs are evidence — for the quality rubric and for drafting. An unanswered question
/// is AWAITING_ANSWER (at most one per page); SKIPPED and WITHDRAWN inputs are kept for the record but are never evidence.
model PlaylistContextInput {
  id             String              @id @default(uuid())
  playlistPageId String
  source         PlaylistInputSource
  status         PlaylistInputStatus
  question       String?             @db.Text
  body           String?             @db.Text
  /// Set for AI-proposed questions: which provider/model/prompt produced the question.
  provider       String?
  model          String?
  promptVersion  String?
  createdById    String
  createdAt      DateTime            @default(now())
  answeredById   String?
  answeredAt     DateTime?
  withdrawnById  String?
  withdrawnAt    DateTime?

  playlistPage PlaylistPage @relation(fields: [playlistPageId], references: [id], onDelete: Cascade)
  createdBy    StudioUser   @relation("PlaylistInputCreatedBy", fields: [createdById], references: [id])
  answeredBy   StudioUser?  @relation("PlaylistInputAnsweredBy", fields: [answeredById], references: [id], onDelete: SetNull)
  withdrawnBy  StudioUser?  @relation("PlaylistInputWithdrawnBy", fields: [withdrawnById], references: [id], onDelete: SetNull)

  @@index([playlistPageId, status])
  @@map("playlist_context_inputs")
}

enum PlaylistDraftTarget {
  SUMMARY
  BODY
}

enum PlaylistDraftStatus {
  PROPOSED
  ACCEPTED
  REJECTED
}

/// A DRAFT of a playlist page's summary or body proposed by the AI from approved evidence only. It changes nothing by itself: a person accepts it
/// into the page's draft (which then still has to pass the quality rubric and be published by someone who may publish). `claims` records, for each
/// statement, the evidence it rests on; `evidenceFingerprint` identifies the evidence set it was written from, so a proposal made from evidence
/// that has since changed cannot be accepted.
model PlaylistDraftProposal {
  id                  String              @id @default(uuid())
  playlistPageId      String
  target              PlaylistDraftTarget
  proposedContent     String              @db.Text
  claims              Json
  evidenceFingerprint String
  provider            String
  model               String
  promptVersion       String
  status              PlaylistDraftStatus @default(PROPOSED)
  requestedById       String
  createdAt           DateTime            @default(now())
  decidedById         String?
  decidedAt           DateTime?

  playlistPage PlaylistPage @relation(fields: [playlistPageId], references: [id], onDelete: Cascade)
  requestedBy  StudioUser   @relation("PlaylistDraftRequestedBy", fields: [requestedById], references: [id])
  decidedBy    StudioUser?  @relation("PlaylistDraftDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([playlistPageId, status])
  @@map("playlist_draft_proposals")
}

{
  "name": "music-madras-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:db:start": "tsx scripts/testDatabase.ts start",
    "test:integration:db:stop": "tsx scripts/testDatabase.ts stop",
    "test:integration:setup": "tsx scripts/testDatabase.ts setup",
    "test:integration:reset": "tsx scripts/testDatabase.ts reset",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "seed:founder": "tsx scripts/seedFounder.ts",
    "youtube:full-sync": "tsx scripts/runYouTubeFullSync.ts",
    "reconcile:exposure-approvals": "tsx scripts/reconcileExposureApprovals.ts",
    "backfill:revision-relationships": "tsx scripts/backfillRevisionRelationships.ts",
    "reproject:legacy-relationships": "tsx scripts/reprojectLegacyRelationships.ts",
    "design:evaluate": "tsx scripts/evaluateVisualDirections.ts",
    "design:specimen": "tsx scripts/generateDirectionSpecimen.ts",
    "migrate": "tsx scripts/migrate.ts",
    "migrations:manifest": "tsx scripts/writeMigrationManifest.ts",
    "ops:check-config": "tsx scripts/checkProductionConfig.ts",
    "ops:smoke": "tsx scripts/smokeTest.ts",
    "ops:verify-database": "tsx scripts/verifyDatabase.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@auth/core": "0.41.3",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.1",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^7.10.1",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    },
    "@auth/core": {
      "nodemailer": "$nodemailer"
    }
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "@embedded-postgres/windows-x64@17.10.0-beta.17": true,
    "esbuild": false,
    "unrs-resolver": false,
    "@embedded-postgres/darwin-arm64": false,
    "@embedded-postgres/darwin-x64": false,
    "@embedded-postgres/linux-arm": false,
    "@embedded-postgres/linux-arm64": false,
    "@embedded-postgres/linux-ia32": false,
    "@embedded-postgres/linux-ppc64": false,
    "@embedded-postgres/linux-x64": false,
    "fsevents": false
  }
}

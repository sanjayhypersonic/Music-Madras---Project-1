# Music Madras production app — environment variables
#
# Copy this file to .env (or .env.local) for local development and fill in real
# values. Never commit a file containing real values — only this example, with
# placeholders, is checked in (.gitignore ignores every other .env* file).
#
# Every variable listed here is read by the code today; variables for features
# that do not exist yet are deliberately not listed. In production, set these in
# the hosting provider's environment settings, never in a file.

# --- Database (ADR §6) ---
# Pooled (PgBouncer-compatible) connection string, used by the running app.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require
# Direct (non-pooled) connection string for the SAME database. Used by Prisma
# (generate, migrate deploy) and by the YouTube sync run lock. The build runs
# `prisma generate`, which needs this variable to be present.
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# --- Public site origin (required in production) ---
# The public address of the site, e.g. https://musicmadras.example — scheme and
# host only. Used for canonical URLs, structured data, the sitemap, robots.txt
# and links in Studio emails. Production fails loudly if it is missing, not
# https, or a localhost address.
PUBLIC_SITE_URL=https://www.example.org

# --- Studio authentication (ADR §7) ---
# A long random string (for example `openssl rand -base64 32`). Required.
AUTH_SECRET=replace-with-a-long-random-string
# The URL Studio is served from. In production it must start with https:// —
# that also switches the session cookie to Secure. (Not used for public URLs.)
AUTH_URL=http://localhost:3000
# Optional Google sign-in; leave empty to keep Studio on email + password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Founder bootstrap (scripts/seedFounder.ts; `npm run seed:founder`) ---
# Only read when creating the very first account. Not needed at runtime.
FOUNDER_EMAIL=founder@example.org
FOUNDER_NAME=Founder Name

# --- Transactional email (password reset, invitations) ---
# "smtp" sends through any SMTP service you choose. In development you may leave
# EMAIL_PROVIDER unset and messages are printed to the server console instead;
# in production an unset/invalid provider is an error — it never falls back to
# the console.
EMAIL_PROVIDER=smtp
SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
EMAIL_FROM="Music Madras <studio@example.org>"

# --- YouTube Data API (ADR §11-13) ---
# Read-only API key and the channel to synchronize. Used by `npm run
# youtube:full-sync`; there is no scheduler or button that runs a sync.
YOUTUBE_API_KEY=replace-with-api-key
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx

# --- Analytics: GA4 (optional) ---
# Without both of these, GA4 sending is a safe no-op (never a network call).
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# --- AI Generation Gateway (optional; nothing generates automatically) ---
# AI_PROVIDER selects the adapter (modules/ai/provider/aiProviderRegistry.ts);
# only "anthropic" and "fake" exist. AI_MODEL overrides the provider's default.
# Without ANTHROPIC_API_KEY the Anthropic adapter reports itself unconfigured.
AI_PROVIDER=
AI_MODEL=
ANTHROPIC_API_KEY=

# --- Integration tests only (never set in a deployed environment) ---
# `npm run test:integration` creates and deletes rows, so it refuses to run
# against a non-local database unless that database's host is named here.
# ALLOW_INTEGRATION_TESTS_ON_HOST=host-of-your-development-database

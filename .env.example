# Music Madras production app — environment variables
#
# Copy this file to .env.local for local development. Never commit a file
# containing real values — only this example file with placeholders is
# checked into the repository.
#
# Phase 1 note: none of these need real values yet. No external database,
# credentials, or infrastructure has been created as part of Phase 1 — see
# docs/phase-1-foundation.md. Prisma commands that only read schema.prisma
# (validate, generate) work without a real DATABASE_URL. Commands that
# connect to a database (migrate dev/deploy, db push) will not work until
# a real Postgres connection string is provided here.

# --- Database (ADR §6) ---
# Pooled (PgBouncer-compatible) connection string, used by the running app.
DATABASE_URL="postgresql://user:password@host:5432/musicmadras?sslmode=require"
# Direct (non-pooled) connection string, used only for migrations.
DIRECT_URL="postgresql://user:password@host:5432/musicmadras?sslmode=require"

# --- Auth (ADR §7) — not wired up in Phase 1 ---
AUTH_SECRET="generate-a-random-32-byte-secret"
AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- YouTube Data API (ADR §11-13) — not used in Phase 1 ---
YOUTUBE_API_KEY=""
YOUTUBE_CHANNEL_ID=""

# --- Media storage (ADR §18) — not used in Phase 1 ---
BLOB_READ_WRITE_TOKEN=""

# --- Background jobs (ADR §12) — not used in Phase 1 ---
CRON_SECRET="generate-a-random-secret"

# --- Transactional email (ADR §7, open item) — not used in Phase 1 ---
EMAIL_PROVIDER_API_KEY=""

# --- Analytics: GA4 (Phase 3 architecture, wired to the public Museum in
# Phase 6G-18) — no real value exists anywhere in this repository yet.
# Without both of these, modules/analytics/providers/ga4/ga4Adapter.ts's
# send() is a safe no-op (never a network call) — the Museum works
# identically with or without them. Populate with a real GA4 property's
# Measurement ID and a Measurement Protocol API secret (created in the GA4
# Admin UI) to actually start receiving events.
GA4_MEASUREMENT_ID=""
GA4_API_SECRET=""

# --- AI Generation Gateway (Phase 6H-5) — provider-agnostic. No generation
# happens automatically anywhere in this codebase (no scheduler, no bulk
# job, no button wired to a page yet). AI_PROVIDER selects the adapter
# (modules/ai/provider/aiProviderRegistry.ts); only "anthropic" and "fake"
# exist. AI_MODEL overrides the provider's own default model. Without
# ANTHROPIC_API_KEY, the Anthropic adapter reports itself unconfigured and
# generate() returns a normalized CONFIGURATION error — never a network
# call, never a raw exception.
AI_PROVIDER="anthropic"
AI_MODEL=""
ANTHROPIC_API_KEY=""
